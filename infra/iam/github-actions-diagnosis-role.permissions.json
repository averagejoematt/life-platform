{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockVisionQA",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:*:205930651321:inference-profile/us.anthropic.claude-*",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-*"
      ]
    },
    {
      "Sid": "QaArchiveScreenshotWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::matthew-life-platform/generated/qa_archive/screenshots/*"
      ]
    },
    {
      "Sid": "QaArchivePerfReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::matthew-life-platform/generated/qa_archive/perf/*"
      ]
    },
    {
      "Sid": "QaArchivePerfList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::matthew-life-platform"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "generated/qa_archive/perf/*"
          ]
        }
      }
    }
  ]
}
