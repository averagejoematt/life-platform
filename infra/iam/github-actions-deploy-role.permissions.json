    {
      "Sid": "LambdaSiteApiRecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:us-west-2:205930651321:function:life-platform-site-api"
    },
    {
      "Sid": "LambdaListAccountLevel",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3DeployArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::matthew-life-platform/deploys/*",
        "arn:aws:s3:::matthew-life-platform/site/*",
        "arn:aws:s3:::matthew-life-platform/config/*",
        "arn:aws:s3:::matthew-life-platform/www-previous/*"
      ]
    },
    {
      "Sid": "S3IamAdditiveGateLedger",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::matthew-life-platform/remediation-log/iam-additive-gate/*"
    },
    {
      "Sid": "S3BucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::matthew-life-platform"
    },
    {
      "Sid": "S3DeployArtifactTagging",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::matthew-life-platform/deploys/*"
    },
    {
      "Sid": "S3BucketNotificationRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketNotification"
      ],
      "Resource": "arn:aws:s3:::matthew-life-platform"
    },
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:205930651321:table/life-platform"
    },
    {
      "Sid": "SNS",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:us-west-2:205930651321:life-platform-alerts",
        "arn:aws:sns:us-west-2:205930651321:life-platform-alerts-digest"
      ]
    },
    {
      "Sid": "SQS",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:us-west-2:205930651321:life-platform-ingestion-dlq"
    },
    {
      "Sid": "KMS",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-west-2:205930651321:key/444438d1-a5e0-43b8-9391-3cd2d70dde4d"
    },
    {
      "Sid": "KMSDecryptViaDynamoDB",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-west-2:205930651321:key/444438d1-a5e0-43b8-9391-3cd2d70dde4d",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "dynamodb.us-west-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EventBridge",
      "Effect": "Allow",
      "Action": [
        "events:DescribeRule",
        "events:ListRules",
        "events:ListTargetsByRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatch",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-west-2:205930651321:secret:life-platform/*"
      ]
    },
    {
      "Sid": "CloudFormationDiff",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackResource",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeStackEvents",
        "cloudformation:ListStacks",
        "cloudformation:DescribeStackSet",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CDKBootstrapRoleAssume",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-deploy-role-205930651321-us-west-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-file-publishing-role-205930651321-us-west-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-image-publishing-role-205930651321-us-west-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-lookup-role-205930651321-us-west-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-deploy-role-205930651321-us-east-1",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-file-publishing-role-205930651321-us-east-1",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-image-publishing-role-205930651321-us-east-1",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-lookup-role-205930651321-us-east-1",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-deploy-role-205930651321-us-east-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-file-publishing-role-205930651321-us-east-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-image-publishing-role-205930651321-us-east-2",
        "arn:aws:iam::205930651321:role/cdk-hnb659fds-lookup-role-205930651321-us-east-2"
      ]
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::205930651321:distribution/E3S424OXQZ8NBE"
    },
    {
      "Sid": "DenyLifeOsPrivatePrefixes",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::matthew-life-platform/claude-memory-backup/*",
        "arn:aws:s3:::matthew-life-platform/session-artifacts/*"
      ]
