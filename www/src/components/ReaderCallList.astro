---
// "Make your own call" (#6114) — the ONE entry point to the reader-call door, on the ledger index. SELF-GATING: with
// WEB_READERCALL off it renders nothing, so the page is byte-identical to a build without it. With the switch on it
// lists the snapshot's candidate calls (open coach calls of a one-tap kind) as links to their own pages; the island asks
// /api/reader_call about each and shows only the ones the API says are open, with the day calls close.
import { READERCALL_API, READERCALL_MARKER, itemIdOf, readerCallEnabled, readerCallFor } from "../lib/readercall.js";
import { href, pathOf } from "../lib/url.js";

interface Props {
  rows: any[];
  measureOf: (p: any) => string;
}
const { rows, measureOf } = Astro.props;
const on = readerCallEnabled();
const candidates = on ? rows.filter((p) => p.status === "pending" && readerCallFor(p)) : [];
const mark = { [READERCALL_MARKER]: "list" };
---

{
  on && (
    <section {...mark} data-api={READERCALL_API} aria-labelledby="rc-list-h" style="margin-top:22px;border:1px solid var(--ink);padding:16px 18px;display:flex;flex-direction:column;gap:10px;max-width:760px">
      <h2 class="label" id="rc-list-h" style="font-size:13px">Make your own call</h2>
      <p style="font-size:14px;line-height:1.5">Can you call it as well as the coaches? Pick an open coach call and make your own. Reader calls are counted apart from the coaches' record.</p>
      <ul class="rows" style="list-style:none;padding:0;margin:0" data-rc-list>
        {candidates.map((p) => (
          <li data-rc-item={itemIdOf(p.id)} style="display:none">
            <a href={href(pathOf("prediction", p.id))}>
              <span><b>{p.coach_name}</b> · {measureOf(p)}</span>
              <span class="mono muted" style="font-size:12px" data-rc-closes>open</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted" style="font-size:13px" data-rc-none>Checking which calls are open…</p>
    </section>
  )
}
