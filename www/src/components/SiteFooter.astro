---
import { href } from "../lib/url.js";
import { snapshotMode } from "../lib/snapshot.js";

const fixture = (await snapshotMode()) === "fixture";
---

<footer class="site">
  <div class="wrap" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px">
    <p style="display:flex;flex-wrap:wrap;gap:18px;align-items:center">
      <span class="verified">Every figure from the platform, dated</span>
      {fixture && <span class="chip">Sample content, for layout only</span>}
    </p>
    {/* The owner's approved wording (2026-11-14). On a phone the coaches line is dropped: the front page says it in its
        coaching band, and the page's phone-height budget (tests/web_preview_gate.py) has no line to spare. */}
    <p style="max-width:540px">
      Only information I've deliberately approved appears here. Selected health measurements are public; journals, genetic findings and other
      sensitive records remain private.<span class="foot-coaches"> The coaches are software built with Claude, not people.</span>
    </p>
    <p style="display:flex;flex-wrap:wrap;gap:18px">
      {/* following is one click from every page (2026-11-15): the email form and the chapter feed are site/-owned */}
      <a href="https://averagejoematt.com/subscribe/">Follow by email</a>
      <a href="https://averagejoematt.com/rss.xml">RSS</a>
      <a href={href("/system/everything-else/")}>Everything else on the site</a>
      <a href={href("/privacy/")}>Privacy</a>
      <a href="https://github.com/averagejoematt/life-platform">The code</a>
    </p>
  </div>
</footer>
