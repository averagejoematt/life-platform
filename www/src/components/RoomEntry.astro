---
// The Coaching Room's entry on /system/ (CR1, built dark). SELF-GATING: with WEB_ROOM off (src/lib/room.js) this
// component renders nothing and reads nothing — not even the room's data file — so /system/ is byte-identical to a
// build without it. No <style>, no <script>: it adds no asset to the build either way.
import { recordHeadline } from "../lib/calibration.js";
import { ROOM_MARKER, roomEnabled } from "../lib/room.js";
import { loadCalibration } from "../lib/snapshot.js";
import { href } from "../lib/url.js";

const on = roomEnabled();
const head = on ? recordHeadline(await loadCalibration()) : null;
const room = { [ROOM_MARKER]: "entry" };
---

{
  on && (
    <section class="section" {...room} style="border-top:1px solid var(--ink)">
      <div class="wrap" style="display:flex;flex-direction:column;gap:14px;max-width:900px">
        <p class="label">The Coaching Room · private build, not published</p>
        {head ? (
          <>
            <h2 style="font-size:30px;line-height:1.15">{head.sentence}</h2>
            <p class="muted" style="font-size:14px;max-width:70ch">{head.caveat}</p>
          </>
        ) : (
          <div class="empty">
            <span>The calibration figures were not served for this snapshot.</span>
          </div>
        )}
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a class="btn ghost sm" href={href("/system/calibration/")}>How sure they were, and how often they were right</a>
          <a class="btn ghost sm" href={href("/system/docket/")}>Where they disagreed, and what the data said</a>
          <a class="btn ghost sm" href={href("/system/ledger/refuted/")}>Wrong this month</a>
        </div>
      </div>
    </section>
  )
}
