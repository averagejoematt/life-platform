---
// The Coaching Room's entry on /system/ (CR1). SELF-GATING: with the room off (src/lib/room.js) this component renders
// nothing and reads nothing — not even the room's data files — so /system/ is byte-identical to a build without it.
// No <style>, no <script> of its own (the published verified lead is drawn by VersusGuess, which the front page also uses). On a private build it says so; on the published
// CR1 build (the committed `room_public: "cr1"`) it is the door to the calibration page and "wrong this month".
// The docket door is CR3: only on a whole-room private build, and only when at least one docket entry is complete
// enough to have a page (owner, 2026-11-09).
import { recordHeadline } from "../lib/calibration.js";
import { docketEntries } from "../lib/docket.js";
import { ROOM_MARKER, roomAll, roomEnabled, roomPublic } from "../lib/room.js";
import { loadCalibration, loadCoachRoom } from "../lib/snapshot.js";
import { href } from "../lib/url.js";
import VersusGuess from "./VersusGuess.astro";

const on = roomEnabled();
const head = on ? recordHeadline(await loadCalibration()) : null;
const docketOpen = on && roomAll() ? docketEntries(await loadCoachRoom()).length > 0 : false;
const pub = on && roomPublic();
const room = { [ROOM_MARKER]: "entry" };
---

{
  on && (
    <section class="section" {...room} style="border-top:1px solid var(--ink)">
      <div class="wrap" style="display:flex;flex-direction:column;gap:14px;max-width:900px">
        <p class="label">{pub ? "The coaches, graded" : "The Coaching Room · private build, not published"}</p>
        {head && pub && head.mode === "verified" ? (
          <VersusGuess links={false} />
        ) : head ? (
          <>
            <h2 style="font-size:clamp(22px,3vw,30px);line-height:1.2">{head.sentence}</h2>
            {head.mode !== "verified" && <p class="muted" style="font-size:14px;max-width:70ch">{head.caveat}</p>}
          </>
        ) : (
          <div class="empty">
            <span>The calibration figures were not served for this snapshot.</span>
          </div>
        )}
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a class="btn ghost sm" href={href("/system/calibration/")}>How the coaches' forecasts were checked</a>
          {docketOpen && <a class="btn ghost sm" href={href("/system/docket/")}>Where they disagreed, and what the data said</a>}
          <a class="btn ghost sm" href={href("/system/ledger/refuted/")}>Wrong this month</a>
        </div>
      </div>
    </section>
  )
}
