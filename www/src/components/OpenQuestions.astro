---
// The open questions (2026-11-14). The experiment's premise is a question it cannot answer yet, and the front page
// showed progress and a record but never the tension. Three of the questions the owner set for the project (the fourth,
// "are the AI coaches any better than a guess?", is asked and answered by the coaches' band further down) — each answered only
// with what the snapshot already publishes, and each saying plainly what is missing. Nothing here is a prediction, a
// score of how he feels, or a new claim: every figure is carried from journey.json, calibration.json, lab.json or the
// edition; a question whose evidence is not served says so instead of guessing.
import { num } from "../lib/format.js";
import { labEnabled } from "../lib/lab.js";
import { labCounts } from "../lib/laboratory.js";
import { dimsFigure, paceFigure, testsFigure } from "../lib/openq.js";
import { loadJourney, loadLab } from "../lib/snapshot.js";
import { href } from "../lib/url.js";

interface Props {
  foodText?: string | null;
  measured: number;
  // the front page's six dimensions (label + whether a public series measures it) — drawn, never re-derived here
  dimensions?: { label: string; measured: boolean }[];
}
const { foodText = null, measured, dimensions = [] } = Astro.props as Props;
const WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const w = (n: number) => WORDS[n] || String(n);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

async function safe<T>(f: () => Promise<T>): Promise<T | null> {
  try {
    return await f();
  } catch {
    return null;
  }
}
const journey: any = await safe(loadJourney);
const j = journey && journey.state === "ok" ? journey : null;
const labFile: any = labEnabled() ? await safe(loadLab) : null;
const lab = labFile && labFile.state === "ok" ? labFile : null;
const counts = lab ? labCounts(lab) : null;
const tests = lab ? (lab.lab_tests || []).filter((t: any) => t.status !== "archived") : [];
const decided = tests.filter((t: any) => {
  const v = t.verdict && typeof t.verdict === "object" ? t.verdict.result : t.verdict;
  return v && v !== "inconclusive";
}).length;

const rate = j && typeof j.weekly_rate_lbs === "number" ? Math.abs(j.weekly_rate_lbs) : null;
const lo = j && typeof j.weekly_rate_ci_high === "number" ? Math.abs(j.weekly_rate_ci_high) : null;
const hi = j && typeof j.weekly_rate_ci_low === "number" ? Math.abs(j.weekly_rate_ci_low) : null;
// The interval's own confidence as served (the journey page reads the same field) — never a hard-coded level.
const level = j && typeof j.projection_confidence === "number" ? Math.round(j.projection_confidence * 100) : null;

const questions = [
  {
    q: "Can he keep this pace without losing strength?",
    have:
      rate != null
        ? `Losing about ${num(rate, 1)} lb a week${lo != null && hi != null && level ? ` (${level}% interval ${num(lo, 1)}–${num(hi, 1)})` : ""} — the pace the platform's rate flag watches, and it fired in Week 10.${foodText ? ` ${foodText}` : ""}`
        : "The pace is not served in this snapshot.",
    missing: "No public strength trend yet, and the scale's body-composition reading is too noisy to settle it.",
    fig: paceFigure({ rate, lo, hi, level }),
    figCap: "lb lost a week, with its interval",
    link: { to: "/data/", words: "The journey and the daily record" },
  },
  {
    q: "Is getting healthier the same as getting happier?",
    have: `${cap(w(measured))} of six dimensions ${measured === 1 ? "is" : "are"} measured in public every day${measured === 3 ? ": the body, sleep and recovery" : ""}.`,
    missing: "Mind, connection and purpose have no public measure. The journal is private, and nothing here infers a feeling from a heartbeat.",
    fig: dimsFigure(dimensions),
    figCap: "filled: measured in public · dashed: no public measure",
    link: { to: "/privacy/", words: "What is measured, and what stays private" },
  },
  {
    q: "Which experiments actually change anything?",
    have: counts
      ? `${cap(w(counts.testsOpen))} tests were written down before their data; ${decided ? `${w(decided)} ${decided === 1 ? "has" : "have"} a verdict` : "none has enough paired days for a verdict yet"}. ${counts.running ? `${cap(w(counts.running))} running` : "No experiment is running"}; ${w(counts.ready)} written and ready to start.`
      : "The laboratory is not served in this snapshot.",
    missing: "Nothing has run long enough to show a change it caused.",
    fig: testsFigure(tests),
    figCap: "each checked test: its paired days toward a verdict",
    link: { to: "/data/", words: "The laboratory, in the data room" },
  },
];
---

<section class="section hair" id="open-questions" data-open-questions>
  <div class="wrap">
    <div class="between" style="margin-bottom:24px">
      <h2>What nobody knows yet</h2>
      <span class="label wide-only">The open questions · read from the record, never guessed</span>
    </div>
    <ol class="oq">
      {
        questions.map((x, i) => (
          <li>
            <span class="oq-n mono">0{i + 1}</span>
            <h3>{x.q}</h3>
            <p class="oq-have">{x.have}</p>
            {x.fig && (
              <figure class="oq-fig">
                <Fragment set:html={x.fig} />
                <figcaption class="label">{x.figCap}</figcaption>
              </figure>
            )}
            <p class="oq-missing">
              <span class="label">Missing</span> {x.missing}
            </p>
            <a href={href(x.link.to)}>{x.link.words} →</a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .oq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    border-top: 1px solid var(--ink);
  }
  .oq li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  .oq li + li {
    padding-left: 22px;
    border-left: 1px solid var(--rule);
  }
  .oq-n {
    color: var(--cobalt);
    font-size: 12px;
  }
  .oq h3 {
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .oq-have {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
  }
  .oq-fig {
    margin: 0;
  }
  .oq-fig svg {
    display: block;
    max-width: none;
  }
  .oq-fig figcaption {
    margin-top: 4px;
  }
  .oq-missing {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  .oq-missing .label {
    margin-right: 4px;
  }
  .oq a {
    margin-top: auto;
    font-size: 13px;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .oq li,
    .oq li + li {
      padding-left: 0;
      border-left: 0;
    }
  }
  /* a phone: the same three questions side by side in a row that scrolls across, the next card's edge showing — the
     front page has a 7.5-screen budget, and the figures would otherwise lengthen it by a third of a screen */
  @media (max-width: 560px) {
    .oq {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 18px;
      border-bottom: 1px solid var(--rule);
    }
    .oq li,
    .oq li + li {
      flex: 0 0 86%;
      scroll-snap-align: start;
      gap: 7px;
      padding: 14px 0 16px;
      border-bottom: 0;
    }
    .oq h3 {
      font-size: 20px;
    }
    .oq-have {
      font-size: 16px;
    }
  }
</style>
