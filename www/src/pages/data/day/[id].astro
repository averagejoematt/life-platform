---
// One day (#5585, epic #5577 — the approved One Day prototype, owner 2026-11-02): the kicker, the
// date in words, one sentence; prev/next, the fourteen-day strip and the any-day scrubber; the ten
// reading tiles, each against its own recent normal (the exporter's numbers, never averaged here);
// the week's chapter in whatever state it is; where the numbers came from; the rail.
//
// Decision 8: changing the date swaps the day in place (islands/day.js) with the URL, the title and
// the canonical kept in sync — and without JavaScript every control is a plain link to the day's page.
// The marked parts ([data-day-part]) are what the island swaps; the scrubber and the live region stay.
import { DISPUTED_NOTE, isDisputed } from "../../../lib/disputed.js";
import Base from "../../../layouts/Base.astro";
import Connected from "../../../components/Connected.astro";
import Provenance from "../../../components/Provenance.astro";
import Quote from "../../../components/Quote.astro";
import {
  READING_TILES,
  deltaLine,
  dekSentence,
  engineLine,
  engineRows,
  fellAsleep,
  foodRows,
  nearestGraded,
  recoveryRows,
  sessionLine,
  sessionRows,
  sessionTitle,
  sparkline,
  stageRows,
  stagesLabel,
  stripWindow,
  tileValue,
  unservedText,
} from "../../../lib/day.js";
import { callOutcome, dayInWords, heldCallWords, num } from "../../../lib/format.js";
import { VISIBLE_CAP, callsAboutDay, leadLine } from "../../../lib/day_coaching.js";
import StatusTag from "../../../components/StatusTag.astro";
import { gradeNoteRows } from "../../../lib/corrections.js";
import { loadAll } from "../../../lib/snapshot.js";
import { href, pathOf } from "../../../lib/url.js";

export async function getStaticPaths() {
  const all = await loadAll();
  return all.byType.day.map((d) => ({ params: { id: d.id }, props: { day: d } }));
}
const { day: d } = Astro.props;
const all = await loadAll();
const days = [...all.byType.day].sort((a, b) => (a.date < b.date ? -1 : 1));
const i = days.findIndex((x) => x.id === d.id);
const byId = new Map(days.map((x) => [x.id, x]));
const prev = d.prev_id ? byId.get(d.prev_id) || null : null;
const next = d.next_id ? byId.get(d.next_id) || null : null;
let prevWeighin = null;
for (let j = i - 1; j >= 0; j--) {
  if (days[j].readings.weight_lbs != null) {
    prevWeighin = days[j];
    break;
  }
}
const short = (iso: string) => (dayInWords(iso, { weekday: true }) || "").replace(/ \d{4}$/, "");
const words = (iso: string) => (dayInWords(iso) || "").replace(/ \d{4}$/, "");
const heading = short(d.date);
const chapter = d.chapter_id ? all.get("chapter", d.chapter_id) : null;
const firstChapterDate = all.byType.chapter.map((c) => c.date).sort()[0] || null;
const weekWords = chapter
  ? `${chapter.week_label}${chapter.status !== "published" ? ` · ${chapter.status}` : ""}`
  : firstChapterDate && d.date < firstChapterDate
    ? "before the first chapter"
    : "no chapter for this week";
const kicker = `${d.weekday} · day ${d.day_number} · ${weekWords}`;
const dek = dekSentence(d, prevWeighin);
const win = stripWindow(days, i);
const pads = 14 - win.length;
const tiles = READING_TILES.map((t) => ({
  ...t,
  href: t.metric && all.get("metric", t.metric) ? href(pathOf("metric", t.metric)) : null,
  value: tileValue(d, t),
  delta: deltaLine(d, t),
  svg: sparkline({ rows: win, tile: t, markDate: d.date, mean: (d.normals[t.key] || {}).mean7 }),
}));
const protein = all.get("metric", "total_protein_g");
const sourceIds = [...new Set([...tiles.map((t) => (t.metric ? all.get("metric", t.metric)?.source_id : null)), "macrofactor"].filter(Boolean))];
const sources = sourceIds.map((id) => all.get("source", id)).filter(Boolean);
const dayHref = (x: { id: string }) => href(pathOf("day", x.id));
const stripLabel = (x: any) => `${short(x.date)}, ${x.readings.weight_lbs != null ? `${x.readings.weight_lbs.toFixed(1)} pounds` : "no weigh-in"}`;
const status = `The data · one day · ${words(d.date)}`;
// Every day since the start, by program week — the no-JavaScript door the scrubber stands in for.
const weeks: { n: number; days: any[] }[] = [];
for (const x of days) {
  const ch = x.chapter_id ? all.get("chapter", x.chapter_id) : null;
  const n = ch && ch.week >= 1 ? ch.week : Math.floor((x.day_number - 1) / 7) + 1; // the chapter's interval decided the day's week at export
  if (!weeks.length || weeks[weeks.length - 1].n !== n) weeks.push({ n, days: [] });
  weeks[weeks.length - 1].days.push(x);
}
// M4 (#5586): the day's layers 2–3, every figure the exporter's. `when` names the day in every unavailable sentence.
const when = short(d.date);
const session = d.workout ? { title: sessionTitle(d.workout.title), line: sessionLine(d.workout), rows: sessionRows(d.workout) } : null;
const night = d.night;
const bed = night ? night.by_device.eightsleep : null;
const strap = night ? night.by_device.whoop : null;
const asleep = night ? fellAsleep(night.sleep_start) : null;
const devices = [bed && bed.hours != null ? `${num(bed.hours, 1)} h by the bed` : null, strap && strap.hours != null ? `${num(strap.hours, 1)} h by the strap` : null].filter(
  Boolean,
) as string[];
const stages = night ? stageRows(night) : [];
const recovery = recoveryRows(d);
const food = d.food;
const engine = d.engine ? { line: engineLine(d.engine), rows: engineRows(d.engine) } : null;
// On a day whose food record is incomplete the engine scored that record as if it were eaten (character_engine reads the
// MacroFactor totals; the absence rule covers a missing day, not a stub). Say what the nutrition number measures there.
const gapPillar = food && food.logging_gap && d.engine ? d.engine.pillars.find((p: any) => p.name === "nutrition" && p.score != null) || null : null;
const weekSpan = chapter && chapter.week_start && chapter.week_end ? `${words(chapter.week_start)} to ${words(chapter.week_end)}` : null;
const after = next ? next.coach_lines : [];
const nearest = d.calls_settled.length ? null : nearestGraded(days, i);
const predHref = (id: string) => (all.get("prediction", id) ? href(pathOf("prediction", id)) : null);
// A withheld claim's chip carries the hold's own sentence ("Not quoted: …"), authored copy, never the coach's words (#5609).
const heldWords = (id: string) => Boolean(all.get("prediction", id)?.claim_withheld);
// A withheld call reads as its frozen test when one is served (lib/format.js::heldCallWords), else the hold's sentence.
const heldText = (id: string, fallback: string) => heldCallWords(all.get("prediction", id)) || fallback;
// Owner rulings 2026-11-03: a verdict under classification review is printed as graded, with the dispute beside it.
const disputedNote = (id: string) => (isDisputed(all.get("prediction", id)) ? ` · ${DISPUTED_NOTE}` : "");
const coachHref = (id: string) => (all.get("coach", id) ? href(pathOf("coach", id)) : null);
const foodTile = food
  ? { value: food.calories != null ? num(food.calories, 0) : "—", unit: "kcal", d: food.logging_gap ? "a logging gap — entries not made; not counted as eaten" : `${food.protein_g != null ? `${num(food.protein_g, 0)} g protein` : "protein not logged"}${food.floor_g != null ? ` · floor ${num(food.floor_g, 0)} g` : ""}` }
  : { value: "—", unit: "", d: d.food_state === "not logged" ? "not logged — missing, not zero" : "not readable for this day" };
// The day → what the coaches called about it → how the window closed (owner brief 2026-11-12). The public ledger's own
// objects, withheld calls left out entirely (lib/day_coaching.js); no calls, no section — the part stays as an empty
// anchor so the in-place day swap (islands/day.js) can fill it.
const dayCalls = callsAboutDay(all.byType.prediction, d.date);
const dayCallsShown = dayCalls.slice(0, VISIBLE_CAP);
const dayCallsMore = dayCalls.slice(VISIBLE_CAP);
const provenance = { state: d.state, as_of: d.as_of, data_through: d.data_through, sample: d.sample, source: d.source, absent_text: d.absent_text };
---

<Base title={heading} top="data" description={`${heading}, day ${d.day_number}: ${dek}`} status={status}>
  <Fragment slot="head">
    {prev && <link rel="prev" href={dayHref(prev)} />}
    {next && <link rel="next" href={dayHref(next)} />}
  </Fragment>
  <div class="dayview" data-day-root data-day-id={d.id} data-base={import.meta.env.BASE_URL}>
    <section class="section" style="padding-bottom:8px" data-day-part="head">
      <div class="wrap" style="display:flex;flex-direction:column;gap:12px">
        <div class="row"><span class="label">{kicker}</span><Provenance object={provenance} /></div>
        <h1 tabindex="-1" data-day-h1>{heading}</h1>
        <p class="dek" style="color:var(--ink)">{dek}</p>
        <nav class="daynav" aria-label="Other days">
          {
            prev ? (
              <a class="dn" href={dayHref(prev)} data-day-link data-focus="prev">
                <span aria-hidden="true">←</span> <span>{short(prev.date)}</span>
              </a>
            ) : (
              <span class="dn muted">the start</span>
            )
          }
          <div class="strip" role="group" aria-label="The fourteen days ending on this one">
            {Array.from({ length: pads }, () => <span class="pad" aria-hidden="true" />)}
            {
              win.map((x) => (
                <a
                  href={dayHref(x)}
                  data-day-link
                  data-focus={`strip-${x.id}`}
                  aria-current={x.id === d.id ? "date" : undefined}
                  aria-label={stripLabel(x)}
                >
                  <span aria-hidden="true">{x.weekday[0]}</span>
                  <i class={x.has_weighin ? "w" : "nw"} aria-hidden="true" />
                </a>
              ))
            }
          </div>
          {
            next ? (
              <a class="dn" href={dayHref(next)} data-day-link data-focus="next">
                <span>{short(next.date)}</span> <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="dn muted">the latest day</span>
            )
          }
        </nav>
      </div>
    </section>

    <div class="wrap">
      <div class="scrub" data-day-scrub hidden>
        <label for="day-scrub">Any day since the start</label>
        <input
          type="range"
          id="day-scrub"
          min="0"
          max={String(days.length - 1)}
          step="1"
          value={String(i)}
          aria-valuetext={`${heading}, day ${d.day_number}`}
          data-day-index
        />
        <output for="day-scrub" class="mono" data-day-out>{heading} · day {d.day_number}</output>
      </div>
      <noscript>
        <nav class="alldays" aria-label="Every day since the start">
          <p class="label">Every day since the start</p>
          {
            weeks.map((w) => (
              <p>
                <span class="mono muted">Week {w.n}</span>{" "}
                {w.days.map((x) => (
                  <a href={dayHref(x)} aria-current={x.id === d.id ? "date" : undefined}>
                    {words(x.date)}
                  </a>
                ))}
              </p>
            ))
          }
        </nav>
      </noscript>
      <p class="srOnly" role="status" aria-live="polite" data-day-live></p>
    </div>

    <section class="section" data-day-part="tiles">
      <div class="wrap">
        <p class="label" style="margin-bottom:12px">The readings · each against its own recent normal</p>
        <div class="tiles day-tiles">
          {
            tiles.map((t) => (
              <div class="tile">
                <span class="label">{t.href ? <a href={t.href}>{t.label}</a> : t.label}</span>
                <span class="v num">
                  {t.value}
                  {t.unit && t.value !== "—" && <small> {t.unit}</small>}
                </span>
                <div class="spark" set:html={t.svg} />
                <span class="d mono">{t.delta}</span>
              </div>
            ))
          }
          <div class="tile">
            <span class="label">{protein ? <a href={href(pathOf("metric", protein.id))}>Food · MacroFactor</a> : "Food · MacroFactor"}</span>
            <span class={`v num${foodTile.value === "—" ? " muted" : ""}`}>
              {foodTile.value}
              {foodTile.unit && foodTile.value !== "—" && <small> {foodTile.unit}</small>}
            </span>
            <span class="d mono">{foodTile.d}</span>
          </div>
          <div class="tile">
            <span class="label">The engine's score</span>
            <span class={`v num${engine ? "" : " muted"}`}>
              {engine ? `Level ${num(d.engine.level, 0)}` : "—"}
              {engine && d.engine.composite != null && <small> · {num(d.engine.composite, 1)}</small>}
            </span>
            <span class="d mono">
              {
                engine
                  ? d.engine.delta != null
                    ? `${d.engine.delta >= 0 ? "+" : "−"}${num(Math.abs(d.engine.delta), 1)} since the morning before`
                    : "no change served"
                  : "not computed for this day"
              }
            </span>
          </div>
        </div>
        <p class="muted" style="font-size:13px;margin-top:10px;max-width:760px">
          Each small line is the fourteen days ending on this one; the dashed rule is the 7-day mean. The means and their counts were computed by the platform when it published
          the day. Point at a line, tap it, or focus it and use the arrow keys to read a day; Escape clears it.
        </p>
      </div>
    </section>

    <section class="section hair" data-day-part="session-night">
      <div class="wrap grid cols2 daylayer" style="gap:40px 56px;align-items:start">
        <div>
          {
            session ? (
              <>
                <h2 data-day-session>The session · {session.title}</h2>
                <p class="small">{session.line}.</p>
                <div class="scroll" tabindex="0" role="region" aria-label={`The session's sets, ${when}`}>
                  <table class="sets-table">
                    <caption class="srOnly">
                      {when}: each exercise's working sets as reps × kilograms at RPE, and its top set
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Exercise</th>
                        <th scope="col">Working sets · reps × kg @RPE</th>
                        <th scope="col" class="r">Top set</th>
                      </tr>
                    </thead>
                    <tbody>
                      {session.rows.map((r) => (
                        <tr class={r.heavy ? "top" : undefined}>
                          <th scope="row">
                            {r.name}
                            {r.warmups > 0 && <span class="small"> · {r.warmups} warm-up{r.warmups > 1 ? "s" : ""}</span>}
                          </th>
                          <td class="sets">
                            {r.noLoad ? (
                              <span class="muted">
                                {r.blocks} block{r.blocks > 1 ? "s" : ""} · no load logged
                              </span>
                            ) : (
                              r.sets.map((x, k) => (k > 0 ? <> · <span class="set">{x}</span></> : <span class="set">{x}</span>))
                            )}
                          </td>
                          <td class="r mono">{r.top}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="small">
                  Warm-up sets are counted in the session but not in its volume. A top set of 100 kg or more is set in bold. Source: Hevy, as logged.
                </p>
              </>
            ) : (
              <>
                <h2 data-day-session>The session</h2>
                <div class="unavail">
                  <b>{d.workout_state === "none logged" ? "No session logged." : "Not readable for this day."}</b> {unservedText("workout", d.workout_state, when)}
                </div>
              </>
            )
          }
        </div>
        <div>
          <h2>Last night, and the morning after</h2>
          {
            night ? (
              <>
                <p class="small">
                  {bed && bed.night_of ? `Night of ${short(bed.night_of)}: ` : ""}
                  {devices.map((x, k) => (k > 0 ? <>, <b>{x}</b></> : <b>{x}</b>))}
                  {devices.length === 2 ? " — two devices, one night, the gap shown rather than averaged." : "."}
                  {night.efficiency != null && ` Efficiency ${num(night.efficiency, 1)} percent.`}
                  {night.score != null && ` Sleep score ${num(night.score, 0)}.`}
                </p>
                {night.deep_pct != null && night.rem_pct != null && night.light_pct != null && (
                  <>
                    <div class="stages" role="img" aria-label={stagesLabel(night)}>
                      <i class="deep" style={`width:${night.deep_pct}%`} />
                      <i class="rem" style={`width:${night.rem_pct}%`} />
                      <i class="light" style={`width:${night.light_pct}%`} />
                    </div>
                    <div class="legend" aria-hidden="true">
                      <span class="deep">deep</span>
                      <span class="rem">REM</span>
                      <span class="light">light</span>
                    </div>
                  </>
                )}
                <div class="rows" style="margin-top:12px">
                  {stages.map((r) => (
                    <span>
                      <span>{r.label}</span>
                      <span class="val">{r.value}</span>
                    </span>
                  ))}
                  <span>
                    <span>Fell asleep</span>
                    <span class="val">{asleep || "not served"}</span>
                  </span>
                </div>
              </>
            ) : (
              <div class="unavail">
                <b>The night's stages are not readable for this day.</b> {unservedText("night", d.night_state, when)}
              </div>
            )
          }
          <p class="label" style="margin-top:18px">Recovery, decomposed</p>
          {
            recovery.map((r) => (
              <div class="bar-row">
                <span class="k">{r.label}</span>
                <span class="t" aria-hidden="true">
                  {r.v != null && <i style={`width:${r.width.toFixed(1)}%`} />}
                </span>
                <span class="v mono">{r.value}</span>
                <span class="note">{r.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section hair" data-day-part="food-engine">
      <div class="wrap grid cols2 daylayer" style="gap:40px 56px;align-items:start">
        <div>
          <h2>What he ate, as logged</h2>
          {
            food ? (
              <>
                <div class="rows">
                  {foodRows(food).map(([k, v]) => (
                    <span>
                      <span>{k}</span>
                      <span class="val">{v}</span>
                    </span>
                  ))}
                </div>
                {food.logging_gap ? (
                  <div class="callout">
                    <b>A logging gap, stated as one.</b> The platform marks {when} as a day with no diary entries: the figures above are what the
                    record holds{d.workout ? `, beside a ${num(d.workout.duration_min, 0)}-minute session` : ""}, not what he ate, so intake that day is unknown. No
                    deficit is published from it, and since 31 October the grader reads such a day as missing. The coaches' notes and the engine's nutrition
                    score for this day were written from the record as if it were eaten; a correction stands beside each line that quotes it.
                  </div>
                ) : (
                  <p class="small">
                    {food.protein_g != null && food.floor_g != null
                      ? food.protein_g >= food.floor_g
                        ? "At or above the protein floor. "
                        : `${num(food.floor_g - food.protein_g, 0)} g under the protein floor. `
                      : ""}
                    The maintenance figure is the platform's estimate over the served window; it publishes a deficit only when one passes its own
                    plausibility check. Source: MacroFactor, as logged.
                  </p>
                )}
              </>
            ) : (
              <div class="unavail">
                <b>{d.food_state === "not logged" ? "Not logged." : "Not readable for this day."}</b> {unservedText("food", d.food_state, when)}
              </div>
            )
          }
        </div>
        <div>
          <h2>The engine's score that morning</h2>
          {
            engine ? (
              <>
                <p class="small">{engine.line}.</p>
                {engine.rows.map((r) => (
                  <div class="bar-row">
                    <span class="k">{r.label}</span>
                    <span class="t" aria-hidden="true">
                      {!r.absent && <i class={r.low ? "low" : undefined} style={`width:${r.width.toFixed(1)}%`} />}
                    </span>
                    <span class={`v mono${r.absent ? " muted" : ""}`}>{r.value}</span>
                  </div>
                ))}
                {gapPillar && (
                  <p class="callout" data-gap-score style="margin-top:10px">
                    <b>What Nutrition {num(gapPillar.score, 0)} means here.</b> The engine scored this day's incomplete record as if it were eaten: {num(food.calories, 0)} kcal
                    against the calorie target and {num(food.protein_g, 0)} g against the protein floor, beside the body-composition trend. It measures the record,
                    not his intake, which is unknown. A day with no record at all has calories and protein marked absent instead.
                  </p>
                )}
                <p class="small" style="margin-top:10px">
                  Seven areas scored nightly from the record; an area with no instrument is shown as absent, never as a middling number.
                </p>
                {d.engine.method && <p class="small" data-engine-method>{d.engine.method}</p>}
              </>
            ) : (
              <div class="unavail">
                <b>Not computed for this day.</b> The character engine served no score dated {when}; no other morning's score stands in for it.
              </div>
            )
          }
        </div>
      </div>
    </section>

    <div data-day-part="coaching">
      {
        dayCalls.length > 0 && (
          <section class="section hair" aria-labelledby="day-calls-h">
            <div class="wrap daycalls">
              <h2 id="day-calls-h">What the coaches called for this day</h2>
              <p class="small muted daycalls-lead">{leadLine(dayCalls, d.date)}</p>
              {[dayCallsShown, dayCallsMore].map((group, gi) => {
                const list = (
                  <ol class="daycall-list">
                    {group.map((c) => (
                      <li class="daycall" data-day-call={c.id} data-timing={c.timing}>
                        <div class="daycall-head">
                          <span class={`when ${c.timing}`}>{c.tag}</span>
                          <span class="daycall-who">
                            {coachHref(c.coach_id) ? <a href={coachHref(c.coach_id)}>{c.coach_name}</a> : c.coach_name} · said {c.saidWords}
                          </span>
                          <StatusTag status={c.status} call disputed={c.disputed} />
                          <a class="daycall-ledger" href={predHref(c.id)}>
                            On the ledger
                          </a>
                        </div>
                        <p class="daycall-line">
                          {c.words ? <>Predicted <Quote text={c.words} said={c.said} /></> : <>Predicted, in the grader's terms: <span class="mono">{c.test}</span></>}{`; the window closed ${c.closedWords}${c.closed}.`}
                        </p>
                        <details class="daycall-more">
                          <summary>How it was graded</summary>
                          <dl class="kv">
                            <dt>When said</dt>
                            <dd>
                              {c.saidWords} · {c.note}
                            </dd>
                            {c.words && c.test && (
                              <>
                                <dt>The test</dt>
                                <dd class="mono">{c.test}</dd>
                              </>
                            )}
                            {!c.words && (
                              <>
                                <dt>The words</dt>
                                <dd>Not published on the ledger; the line above is the grader's test.</dd>
                              </>
                            )}
                            <dt>Window closed</dt>
                            <dd>{c.closedWords}</dd>
                            {c.gradedWords && (
                              <>
                                <dt>Graded</dt>
                                <dd>{c.gradedWords}</dd>
                              </>
                            )}
                            {c.notes && (
                              <>
                                <dt>The grader read</dt>
                                <dd>{c.notes}</dd>
                              </>
                            )}
                            {c.tolerance && (
                              <>
                                <dt>Tolerance</dt>
                                <dd>{c.tolerance}</dd>
                              </>
                            )}
                            {c.guess && (
                              <>
                                <dt>Beside a simple guess</dt>
                                <dd>{c.guess}</dd>
                              </>
                            )}
                            {c.flags.length > 0 && (
                              <>
                                <dt>Flagged</dt>
                                <dd>{c.flags.join(" · ")}</dd>
                              </>
                            )}
                            {c.corrected && (
                              <>
                                <dt>Corrected</dt>
                                <dd>This grade was corrected; the original is kept on the ledger.</dd>
                              </>
                            )}
                          </dl>
                        </details>
                      </li>
                    ))}
                  </ol>
                );
                return gi === 0 ? (
                  list
                ) : group.length > 0 ? (
                  <details class="daycall-rest">
                    <summary>The other {group.length}</summary>
                    {list}
                  </details>
                ) : null;
              })}
            </div>
          </section>
        )
      }
    </div>

    <section class="section hair" data-day-part="coaches-calls">
      <div class="wrap grid cols2 daylayer" style="gap:40px 56px;align-items:start">
        <div>
          <h2>The coaches, that day</h2>
          {
            d.coach_lines.length ? (
              d.coach_lines.map((l) => (
                <figure class="voice">
                  <figcaption class="who">
                    {coachHref(l.coach_id) ? <a href={coachHref(l.coach_id)}>{l.coach}</a> : l.coach} · {l.move_label || l.move}
                  </figcaption>
                  <Quote block text={l.text} said={d.date} />
                  {l.corrections.map((c) => (
                    <p class="correction" role="note">
                      {c}
                    </p>
                  ))}
                  {l.grade_corrections.length > 0 && (
                    <details class="correction-detail">
                      <summary>What changed</summary>
                      {l.grade_corrections.map((g) => (
                        <dl class="kv">
                          {gradeNoteRows(g).map(([k, v]) => (
                            <>
                              <dt>{k}</dt>
                              <dd>{v}</dd>
                            </>
                          ))}
                          {g.prediction_id && g.coach_id && all.get("prediction", `${g.coach_id}-${g.prediction_id}`) && (
                            <>
                              <dt>The call</dt>
                              <dd>
                                <a href={href(pathOf("prediction", `${g.coach_id}-${g.prediction_id}`))}>on the ledger</a>
                              </dd>
                            </>
                          )}
                        </dl>
                      ))}
                    </details>
                  )}
                </figure>
              ))
            ) : (
              <div class="unavail">
                <b>Nothing quotable that day.</b> The coaches' lines are published only when they pass the platform's quotability and privacy filter; {when} had
                none.
              </div>
            )
          }
          {
            next && after.length > 0 && (
              <>
                <p class="label" style="margin-top:16px">The day after · {short(next.date)}</p>
                {after.map((l) => (
                  <figure class="voice after">
                    <figcaption class="who">
                      {l.coach} · {l.move_label || l.move}
                    </figcaption>
                    <Quote block text={l.text} said={next.date} />
                    {l.corrections.map((c) => (
                      <p class="correction" role="note">
                        {c}
                      </p>
                    ))}
                    {l.grade_corrections.length > 0 && (
                      <details class="correction-detail">
                        <summary>What changed</summary>
                        {l.grade_corrections.map((g) => (
                          <dl class="kv">
                            {gradeNoteRows(g).map(([k, v]) => (
                              <>
                                <dt>{k}</dt>
                                <dd>{v}</dd>
                              </>
                            ))}
                          </dl>
                        ))}
                      </details>
                    )}
                  </figure>
                ))}
              </>
            )
          }
        </div>
        <div>
          <h2>Calls graded that day</h2>
          {
            d.calls_settled.length ? (
              <div class="chips">
                {d.calls_settled.map((c) => (
                  <a class="callchip solid" href={predHref(c.prediction_id)}>
                    <span class="k">
                      {callOutcome(c.verdict)}
                      {disputedNote(c.prediction_id)}
                    </span>
                    <span>
                      {c.coach_name}: {heldWords(c.prediction_id) ? heldText(c.prediction_id, c.claim_short) : <Quote text={c.claim_short} />}
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <>
                <p class="small">
                  No call was graded on {when}.{nearest ? " The nearest before it:" : " None was graded before it either."}
                </p>
                {nearest && (
                  <div class="chips">
                    {nearest.calls_settled.slice(0, 2).map((c: any) => (
                      <a class="callchip solid" href={predHref(c.prediction_id)}>
                        <span class="k">
                          {callOutcome(c.verdict)} · {short(nearest.date)}
                          {disputedNote(c.prediction_id)}
                        </span>
                        <span>
                          {c.coach_name}: {heldWords(c.prediction_id) ? heldText(c.prediction_id, c.claim_short) : <Quote text={c.claim_short} />}
                        </span>
                      </a>
                    ))}
                  </div>
                )}
              </>
            )
          }
          <p class="label" style="margin-top:18px">Open calls as of this day, and when they settle</p>
          {
            d.calls_open.length ? (
              <>
                <div class="chips">
                  {d.calls_open.map((c) => (
                    <a class="callchip" href={predHref(c.prediction_id)}>
                      <span class="k">settles {words(c.due_date)}</span>
                      <span>
                        {c.coach_name}: {heldWords(c.prediction_id) ? heldText(c.prediction_id, c.text) : <Quote text={c.text} />}
                      </span>
                    </a>
                  ))}
                </div>
                {d.calls_open_count > d.calls_open.length && (
                  <p class="small" style="margin-top:8px">
                    The {d.calls_open.length} settling soonest of {d.calls_open_count} open; <a href={href("/system/ledger/")}>the ledger</a> has every one.
                  </p>
                )}
              </>
            ) : (
              <p class="small">No call was open on {when}.</p>
            )
          }
        </div>
      </div>
    </section>

    <section class="section hair" data-day-part="week">
      <div class="wrap grid cols2" style="gap:40px 56px;align-items:start">
        <div>
          <h2 style="margin-bottom:12px">The week this day belongs to</h2>
          {
            chapter ? (
              <>
                <div class="rows">
                  <span>
                    <span>{chapter.week_label}</span>
                    <span class="mono">{chapter.status === "published" ? `published · “${chapter.title}”` : chapter.status}</span>
                  </span>
                  {weekSpan && (
                    <span>
                      <span>The week</span>
                      <span class="mono">{weekSpan}</span>
                    </span>
                  )}
                  {chapter.status === "published" && (
                    <span>
                      <span>Published</span>
                      <span class="mono">{words(chapter.date)}</span>
                    </span>
                  )}
                </div>
                {chapter.status === "published" ? (
                  <p style="margin-top:12px">
                    This day's figures appear in the chapter; <a href={href(pathOf("chapter", chapter.id))}>read {chapter.week_label}</a>.
                  </p>
                ) : chapter.status === "skipped" ? (
                  <div class="empty" style="margin-top:12px">
                    <b style="color:var(--ink)">{chapter.absent_text || "No chapter was published for this week."}</b>
                  </div>
                ) : (
                  <div class="empty" style="margin-top:12px">
                    <span>
                      <b style="color:var(--ink)">{chapter.absent_text || chapter.status}</b> When the chapter publishes, this day's figures appear in it and the chapter's text
                      appears here. Nothing stands in for it meanwhile.
                    </span>
                  </div>
                )}
              </>
            ) : (
              <div class="empty">
                <b style="color:var(--ink)">{weekWords === "before the first chapter" ? "Before the first chapter." : "No chapter covers this week."}</b>
              </div>
            )
          }
        </div>
        <div>
          <h2 style="margin-bottom:12px">Where the day's numbers came from</h2>
          {
            sources.length ? (
              <div class="rows">
                {sources.map((s) => (
                  <a href={href(pathOf("source", s.id))}>
                    <span>{s.label}</span>
                    <span class="mono muted">
                      {s.status}
                      {s.latest && dayInWords(s.latest) ? ` · last ${words(s.latest)}` : ""}
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="muted">The platform names no source for these readings in this snapshot.</p>
            )
          }
          <p class="muted" style="font-size:13px;margin-top:10px">Each source's state as of the snapshot, not of this day.</p>
        </div>
      </div>
    </section>

    <section class="section hair" data-day-part="rail">
      <div class="wrap">
        <Connected type="day" id={d.id} heading="Connected to this day" />
      </div>
    </section>
  </div>
</Base>

<script>
  import "../../../islands/day.js";
</script>
