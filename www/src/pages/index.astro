---
// Start — the entry point. Refined after the owner's 2026-11-01 review against the approved
// Stage 2/3 home: the six-dimensional portrait returns beside the premise (no photograph needed),
// the latest chapter is the main feature, the coaches speak in plain words, and every number is
// the edition's or the snapshot's (one producer). His own words are rendered only through
// components/OwnWords.astro: a line he approved by name (lib/own_words.js) that the platform serves exactly.
import Base from "../layouts/Base.astro";
import Provenance from "../components/Provenance.astro";
import StatusTag from "../components/StatusTag.astro";
import VersusGuess from "../components/VersusGuess.astro";
import WhatHappensNext from "../components/WhatHappensNext.astro";
import OwnWords from "../components/OwnWords.astro";
import { NARRATOR_BYLINE } from "../lib/narrator.js";
import { headline, weeklyBars } from "../lib/chart.js";
import { readingWords, scaleWords, weeklySpark } from "../lib/spark.js";
import { chapterCount, chapterMeta, chapterWindow, dayInWords, nextChapter, domainWords, num, kOfN, clip, heldCallWords } from "../lib/format.js";
import { connectedTo, loadAll, loadSeries, latestEdition, dayLine, loadCalibration, loadJourney, loadLab } from "../lib/snapshot.js";
import { labEnabled } from "../lib/lab.js";
import { fourParts, labVerdicts } from "../lib/standing.js";
import { lineCounts, theLine } from "../lib/theline.js";
import { verifiedLead } from "../lib/calibration.js";
import { roomPublic } from "../lib/room.js";
import { href, pathOf } from "../lib/url.js";
import { loadEditorial } from "../lib/editorial_data.js";
import { PATH, PATH_CHAPTERS, progressLine } from "../lib/editorial.js";
import { editionFor, editionReading } from "../lib/chapter_editions.js";
import { loadChapterEditions } from "../lib/snapshot.js";

const all = await loadAll();
const edition = await latestEdition();
const series = await loadSeries();
const blocks: Record<string, any> = (edition && edition.blocks) || {};
const ok = (k: string) => (blocks[k] && blocks[k].state === "ok" ? blocks[k].data : null);
const today = ok("today");
const record = ok("record");
const next = ok("next");
const week = ok("week");
const portrait = ok("portrait") || {};
const lines: any[] = (ok("coach_lines")?.lines || []).slice(0, 3);
const startDate: string | null = today?.start_date || edition?.start_date || null;
// "So far", in one line above the fold (2026-11-14): on a phone the first screen carried the premise and no progress.
// Day, pounds, chapters, the coaches against a guess — each carried from the edition / the room's verified lead.
let soFarLead: ReturnType<typeof verifiedLead> = null;
// #5950: the ledger's own count of dated forecasts (every record that is not an observation), as the producer serves
// it; the snapshot's prediction objects are only the records served with an id, so counting them undercounted.
let ledgerForecasts: number | null = null;
if (roomPublic()) {
  try {
    const f: any = await loadCalibration();
    soFarLead = f?.state === "ok" ? verifiedLead(f.calibration || {}) : null;
    ledgerForecasts = f?.state === "ok" && Number.isInteger(f.record?.total) && Number.isInteger(f.record?.observational) ? f.record.total - f.record.observational : null;
  } catch {
    soFarLead = null;
  }
}

const chapters = [...all.byType.chapter].sort((a, b) => (a.date < b.date ? 1 : -1));
const published = chapters.filter((c) => c.status === "published");
const latestChapter = published[0] || null;
const latestEpisode = latestChapter?.episode_id ? all.get("episode", latestChapter.episode_id) : null;
// 2026-11-14: the story door said "each with audio" while 2 of 8 published chapters had an episode (the rest are
// held or never recorded). The count is read, never assumed.
const withAudio = published.filter((c) => c.episode_id && all.get("episode", c.episode_id)).length;
// #6081: the next chapter's number and date from ONE source — the edition's draft date, numbered by the pending week
// /story/ lists for it (format.js nextChapter). It used to be the latest chapter's week + 1 beside the cadence's date.
const nextCh = next?.chapter?.state === "ok" ? nextChapter(all.byType.chapter, next.chapter.data?.date) : null;
// the chapters counted as /story/ counts them: the numbered chapters, and the prologue said as such
const count = chapterCount(all.byType.chapter);
const latestMeta = chapterMeta(latestChapter);
const inChapterAll = latestChapter ? await connectedTo("chapter", latestChapter.id, { cap: 6 }) : null;
const inChapter = inChapterAll ? { ...inChapterAll, items: inChapterAll.items.filter((e) => e.type !== "edition").slice(0, 4) } : null;
// The latest chapter's week in two lines (2026-11-14): its graded calls and its days, both on the chapter page.
// Read over the chapter's covered days when served (lib/format.js::chapterWindow), as the chapter page does.
const chWindow = chapterWindow(latestChapter);
const chWeekCalls = chWindow
  ? all.byType.prediction.filter(
      (p) => (p.status === "confirmed" || p.status === "refuted") && p.settled_date && p.settled_date.slice(0, 10) >= chWindow[0] && p.settled_date.slice(0, 10) <= chWindow[1],
    )
  : [];
const chWeekRight = chWeekCalls.filter((p) => p.status === "confirmed").length;
const chWeekDays = latestChapter
  ? all.byType.day.filter((d) =>
      latestChapter.covers_start && latestChapter.covers_end ? d.date >= latestChapter.covers_start && d.date <= latestChapter.covers_end : d.chapter_id === latestChapter.id,
    ).length
  : 0;
const pending = all.byType.prediction
  .filter((p) => p.status === "pending")
  .sort((a, b) => ((a.due_date || "9999") < (b.due_date || "9999") ? -1 : 1))
  .slice(0, 3);
const openDisagreements = all.byType.disagreement.filter((d) => d.status === "open");
const coachById = (id: string) => all.get("coach", id) || all.get("coach", `${id}_coach`);
const status = edition ? [dayLine(edition), dayInWords(edition.as_of)].filter(Boolean).join(" · ") : null;
const weekOrder: string[] = week?.order || [];
// "Since your last visit" (islands/since.js): the dated events this page already publishes, as day numbers (no ISO
// date reaches the HTML); the browser remembers only the last edition day it saw.
const dayNo = (iso: string | null | undefined) => (iso && /^\d{4}-\d{2}-\d{2}/.test(iso) ? Math.round(Date.parse(`${iso.slice(0, 10)}T00:00:00Z`) / 864e5) : null);
const sinceEvents = [
  ...published.map((c) => ({ d: dayNo(c.published_at || c.date), k: "chapter", t: c.title, u: href(pathOf("chapter", c.id)) })),
  ...all.byType.prediction.filter((p) => p.status === "confirmed" || p.status === "refuted").map((p) => ({ d: dayNo(p.settled_date), k: p.status })),
].filter((e) => e.d != null);
const sinceAsOf = dayNo(edition?.as_of);
// The front page's share description (2026-11-14, sprint II): the premise plus where it stands, from the edition.
const ogDescription = [
  `An ordinary man started${today?.start_weight_lbs ? ` at ${num(today.start_weight_lbs, 0)} pounds` : ""}${startDate ? ` on ${dayInWords(startDate)}` : ""} and is using AI coaches, his own data and public grades to find out whether getting healthier and getting happier are the same thing.`,
  edition?.day_n != null && today?.change_lbs != null ? `Day ${edition.day_n}: ${num(Math.abs(today.change_lbs), 1)} lb ${today.change_lbs <= 0 ? "down" : "up"}.` : null,
]
  .filter(Boolean)
  .join(" ");
const weekLabel: Record<string, string> = { weight: "Weight", training: "Training", sleep: "Sleep", food: "Food" };

// ── Fig. 1 — The Line (2026-11-14, sprint II): every published weigh-in since day one, the rungs the platform
// published, the published chapters as numbered ticks. Drawn by lib/theline.js; the island redraws it on a phone.
const weightSeries = series["weight_lbs"];
const journeyObj: any = await loadJourney();
const lineDays = weightSeries ? weightSeries.days.filter((d: any) => !startDate || d.date >= startDate) : [];
// each tick sits on the last of the chapter's days (format.js chapterMeta: the covered days, else the program week)
const lineChapters = published.map((c) => chapterMeta(c)?.tick).filter(Boolean) as { date: string; n: string }[];
const lineData = lineDays.some((d: any) => d.value != null)
  ? {
      days: lineDays.map((d: any) => ({ date: d.date, value: d.value, gap: d.gap })),
      startDate,
      startValue: journeyObj?.start_weight_lbs ?? today?.start_weight_lbs ?? null,
      rungs: (journeyObj?.rungs || []).filter((r: any) => r.date),
      chapters: lineChapters,
    }
  : null;
const lineCount = lineCounts(lineDays);
const lineReadings = lineDays.filter((d: any) => d.value != null && !d.gap);
const lineLost = lineReadings.length ? lineReadings[lineReadings.length - 1].value - (lineData?.startValue ?? lineReadings[0].value) : 0;
const lineAria = lineReadings.length
  ? `Every weigh-in since ${dayInWords(lineReadings[0].date)}: from ${num(lineReadings[0].value, 1)} pounds to ${num(lineReadings[lineReadings.length - 1].value, 1)} pounds on ${dayInWords(lineReadings[lineReadings.length - 1].date)}, ${lineCount.readings} weigh-ins in ${lineCount.days} days.`
  : "";
const lineSvg = lineData ? theLine({ ...lineData, aria: lineAria }) : "";

// ── Fig. 1 — the portrait. Body, Sleep and Recovery read their series; Mind and Connection read
// the edition's published counts; Purpose has no instrument. Bars are eight weekly means (or counts).
type Dim = { id: string; label: string; instrument: string; value: string | null; unit: string; bars: (number | null)[] | null; note: string; href: string | null; measured: boolean; key?: string; decimals?: number; latest?: number | null; through?: string | null; what?: string };
function seriesDim(id: string, key: string, label: string, decimals: number, unit: string, noteOf: (h: any, bars: (number | null)[]) => string): Dim {
  const s = series[key];
  const m = all.get("metric", key);
  if (!s) return { id, label, instrument: m?.instrument || "", value: null, unit, bars: null, note: "No series served for this yet.", href: m ? pathOf("metric", key) : null, measured: false };
  const h = headline(s.days);
  const bars = weeklyBars(s.days, 8);
  // #6122: the figure is one reading and the line is weekly means — the figure says which (readingWords) and the scale
  // line says the weeks it covers (`through`, the series' last day), so a night outside the weekly range is not read as
  // a contradiction. The words ride in the figure's own line (the phone hides the note).
  const through = s.days.length ? s.days[s.days.length - 1].date : null;
  return { id, label, instrument: m?.instrument || s.source_id || "", value: h.last == null ? null : num(h.last, decimals), unit, bars, note: noteOf(h, bars), href: pathOf("metric", key), measured: h.last != null, key, decimals, latest: h.last, through, what: readingWords(key) };
}
const firstBar = (bars: (number | null)[]) => bars.find((v) => v != null);
// #5953 contract: the notes name how many weeks are drawn (a series shorter than eight weeks draws fewer), and the
// "last seven nights" mean is the mean of the last seven nights, not the last non-empty bar.
const weeksDrawn = (bars: (number | null)[]) => `${["no", "one", "two", "three", "four", "five", "six", "seven", "eight"][bars.length] || bars.length} ${bars.length === 1 ? "week" : "weeks"}`;
const lastSeven = (key: string) => {
  const got = (series[key]?.days || []).slice(-7).filter((d: any) => d.value != null && !d.gap);
  return got.length ? { mean: got.reduce((a: number, d: any) => a + d.value, 0) / got.length, n: got.length } : null;
};
const dims: Dim[] = [
  seriesDim("body", "weight_lbs", "Body", 1, "lb", (h) => (today?.change_lbs != null && startDate ? `${num(today.change_lbs, 1)} lb since ${dayInWords(startDate, { short: true })}.` : `${h.n} mornings on the scale.`)),
  seriesDim("sleep", "sleep_duration_hours", "Sleep", 1, "h", (h, bars) => {
    const f = firstBar(bars);
    const l = lastSeven("sleep_duration_hours");
    // #5953: the figure is the latest night; the note used to call it "this week's mean" (8.1 h beside a 7.6 h mean).
    // sprint III item 8: the series is dated by the WAKE morning, so its newest point is "last night" only when that
    // morning is the edition's day; an older newest point names its own night (the evening before that morning)
    const night = h.lastDate && edition?.as_of && h.lastDate !== edition.as_of ? `The night before ${dayInWords(h.lastDate, { short: true })}, the latest measured.` : "Last night.";
    const lastWords = l ? (l.n === 7 ? "The last seven nights average" : `The ${l.n} measured of the last seven nights average`) : "";
    return f != null && l ? `${night} ${lastWords} ${num(l.mean, 1)} h; the first of the ${weeksDrawn(bars)} drawn, ${num(f, 1)} h.` : `${h.n} nights measured.`;
  }),
  seriesDim("recovery", "hrv", "Recovery", 0, "ms", (h, bars) => {
    const f = firstBar(bars);
    return f != null ? `Heart-rate variability, the latest morning. The first of the ${weeksDrawn(bars)} drawn averaged ${num(f, 0)} ms.` : `${h.n} mornings measured.`;
  }),
  {
    // Owner ruling 2026-11-03: journal activity is private — whether, when and how often he writes.
    // The tile carries no count, date or bar, and it never counts as a measured dimension.
    id: "mind",
    label: "Mind",
    instrument: "journal",
    value: null,
    unit: "",
    bars: null,
    note: portrait.mind?.text || "The journal is private: what is written, and whether or when, is not published.",
    href: null,
    measured: false,
  },
  {
    id: "connection",
    label: "Connection",
    instrument: "logged interactions",
    value: null,
    unit: "",
    bars: null,
    note:
      portrait.connection?.state === "ok"
        ? portrait.connection.interactions_30d
          ? `${portrait.connection.interactions_30d} logged in the last thirty days; the depth of them is not published.`
          : "None logged in the last thirty days."
        : "Not served at build time.",
    href: null,
    measured: false,
  },
  { id: "purpose", label: "Purpose", instrument: "not yet", value: null, unit: "", bars: null, note: portrait.purpose?.text || "No instrument for this yet. Deliberately an empty frame.", href: null, measured: false },
];
// The Body tile opens the Journey, the same door as The Line above it (one door, so the front page's reach is unchanged).
if (lineData && dims[0].href) dims[0].href = "/data/journey/";
// The measured count never depends on the journal: Mind is never "measured" on a public page.
const measured = dims.filter((d) => d.measured).length;
const WORDS = ["none", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
// The spark is the shared contract's (lib/spark.js, review 2026-11-14): bars from zero, or a line on a labelled range when
// the weeks differ by little against their level — the same picture the data room draws for the same series.
const sparkOf = (d: Dim) => weeklySpark(d.bars || [], { faint: d.value == null });

// ── Where the experiment stands (2026-11-15, owner ruling on #6067). The front page opened on the weight and read as a
// weight-loss site. The experiment has four parts and only the first is settled, so the page says that before The
// Line — each part from a figure the snapshot serves, never a judgement made here: the body (The Line's own change),
// the behaviour (the Laboratory's pre-registered tests, and how many have a verdict), the life (the dimensions with a
// public measure) and the AI (the checked record beside a simple guess on the same calls, with the producer's verdict).
// A part whose figure is not served says so. Each figure opens its sentence, so it reads as one line on a phone.
// The four figures come from lib/standing.js — the one producer the Story, Data and System strips read too
// (components/FourParts.astro); this page adds its own sentences.
let labFile: any = null;
if (labEnabled()) {
  try {
    labFile = await loadLab();
  } catch {
    labFile = null;
  }
}
// The editorial release (owner, review 14): the body figure, the first screen's data line and "What happens next" read ONE
// computation (lib/editorial_data.js loadEditorial → lib/editorial.js progress, over standing.js bodyChange with the
// same series, start day and start weight this page always used), so the three cannot disagree.
const ed = await loadEditorial();
const body = ed.p ? ed.p.body : null;
const dataLine = progressLine(ed.p);
const rateFlag = all.get("chapter", PATH_CHAPTERS["rate-flag"]);
const rateFlagEd = rateFlag ? editionFor(await loadChapterEditions(), rateFlag.id) : null;
const rateFlagMin = rateFlagEd ? editionReading(rateFlagEd).read_minutes : rateFlag?.read_minutes;
const fp = fourParts({ body, lab: labVerdicts(labFile), measured, lead: soFarLead });
const fig = (id: string) => fp.find((p) => p.id === id)!;
const labTests = labVerdicts(labFile);
const aiWords = soFarLead?.sign?.words ? `${soFarLead.sign.words.charAt(0).toUpperCase()}${soFarLead.sign.words.slice(1)}.` : null;
const lighter = body ? body.lost < 0 : false;
type Standing = { id: string; part: string; status: string; value: string | null; text: string; to: string };
const standing: Standing[] = [
  {
    ...fig("body"),
    text: body
      ? `${lighter ? "lighter" : "heavier"} in ${body.days} days, across ${body.readings} weigh-ins. ${lighter ? "The weight loss is real: it" : "It"} is the line below.`
      : "The weigh-ins are not served in this snapshot.",
    to: "#the-line",
  },
  {
    ...fig("behaviour"),
    text: labTests
      ? `pre-registered tests ${labTests.decided === 1 ? "has" : "have"} a verdict. Whether the new habits hold is not known yet.`
      : "Whether the new habits hold is not known yet; the Laboratory is not served in this snapshot.",
    to: "#what-happens-next",
  },
  {
    ...fig("life"),
    text: `dimensions of a life have a public measure${measured === 3 ? ", all of them the body's" : ""}. Whether I'm happier is not established.`,
    to: "#portrait",
  },
  {
    ...fig("ai"),
    text: soFarLead?.baseline
      ? `coach forecasts right against a simple guess's, on the same ${soFarLead.n} calls.${aiWords ? ` ${aiWords}` : ""}`
      : "The coaches' checked record is not served in this snapshot.",
    to: "#coaches",
  },
];
---

<Base title="Average Joe Matt" top="start" status={status} card="home" description={ogDescription}>
  <section class="section opening">
    <div class="wrap">
      <p class="label">
        An experiment, in public{startDate && ` · began ${dayInWords(startDate)}`}{edition?.day_n != null && ` · day ${edition.day_n}`}
      </p>
      {/* The first screen (owner authorisation, review 14, 2026-11-24). The headline and the opening paragraph are the
          owner's own first-person words, authorised exactly: STATIC text, never a variable, never generated or rewritten
          by code — scripts/check_www_build.py::first_person_pin hashes both as built. The data line below them is the
          platform's voice and changes with the data. */}
      <div class="ed-hero-grid">
        <div class="ed-hero"><h1 data-first-person-headline>I lost 115 pounds once. I regained it all, and more.</h1></div>
        <div>
          <p class="ed-opening" data-first-person>I’m Matt. British, in Seattle. On 6 September 2026 I weighed 327.3 pounds and started again, by my own count ‘the 15th or 16th reset in a few months’. This time a team of AI coaches is part of it. I can’t yet say whether the coaches are helping.</p>
          {dataLine && <p class="ed-dataline" data-progress-line data-progress-below={ed.p.below}>{dataLine}</p>}
          <a class="ed-btn" href={href(PATH[0].to)}>Start with one week: The Rate Flag{rateFlagMin ? ` · ${rateFlagMin} min` : ""}{"\u00a0→"}</a>
          <div class="ed-links"><a href={href(PATH[1].to)}>How it started</a><a href={href("/system/coaches/")}>Meet the coaches</a></div>
          <p class="ed-tagline">Can an ordinary person engineer an extraordinary life?</p>
          <div class="ed-how" data-how-checked>
            <b>How the coaches are checked</b>
            <p>Every night the data lands in one place and each coach reads one slice of it. Each prediction they make carries a date; when the date arrives, a separate program checks it, and the result is published, right or wrong.</p>
            {
              ed.checked && (
                <p data-coaches-checked>
                  As of {dayInWords(ed.checked.asOf)}: of {ed.checked.eligible} coach predictions graded right or wrong so far, {ed.checked.n} could be checked fairly. On those {ed.checked.n} the coaches were right {ed.checked.k} times and a guess that nothing changes {ed.checked.baseline} times{ed.checked.words ? `: ${ed.checked.words}` : ""}. Predictions still open are not counted. <a href={href("/system/calibration/")}>How the grading works →</a>
                </p>
              )
            }
          </div>
        </div>
      </div>
      <div class="standing" data-standing>
        <div class="between standing-head">
          <p class="label">Where the experiment stands{edition?.day_n != null && ` · day ${edition.day_n}`}</p>
          {lighter && <p class="label standing-gist">The weight loss is real · the rest is still open</p>}
        </div>
        <ol class="standing-rows">
          {
            standing.map((x) => (
              <li class={`standing-row st-${x.id}`}>
                <a class="standing-part" href={x.to}>
                  <span class="label">{x.part}</span>
                  <span class={`standing-status ${x.id === "body" ? "is-measured" : ""}`}>{x.status}</span>
                </a>
                <p class="standing-text">
                  <b class={`standing-v num ${x.value == null ? "hollow" : ""}`}>{x.value == null ? "—" : x.value}</b> {x.text}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      {
        lineData && (
          <figure class="theline" id="the-line" data-theline data-payload={JSON.stringify(lineData)} data-aria={lineAria}>
            <figcaption class="theline-head">
              <span class="label theline-fig">Fig. 1 — The Line · the part that is measured · every morning on the scale since day one</span>
            </figcaption>
            <div class="theline-chart" data-theline-chart set:html={lineSvg} />
            <div class="theline-key">
              <ul class="theline-legend">
                <li><svg viewBox="0 0 28 12" width="28" height="12" aria-hidden="true"><path d="M2,9 L14,4 L26,6" fill="none" stroke="#121212" stroke-width="1.6"/><circle cx="14" cy="4" r="2.6" fill="#121212"/></svg>a morning on the scale · {lineCount.readings} in {lineCount.days} days</li>
                <li><svg viewBox="0 0 28 12" width="28" height="12" aria-hidden="true"><path d="M2,4 L26,8" fill="none" stroke="#121212" stroke-width="1.4" stroke-dasharray="2 3"/><rect x="12.5" y="4" width="3" height="7" fill="none" stroke="#5C5C58"/></svg>no weigh-in · {lineCount.missing} {lineCount.missing === 1 ? "morning" : "mornings"}, left blank</li>
                <li><svg viewBox="0 0 28 12" width="28" height="12" aria-hidden="true"><rect x="1" y="1" width="26" height="10" fill="#1B3FD6" opacity="0.14"/></svg>below the first morning</li>
                {lineChapters.length > 0 && <li><svg viewBox="0 0 28 12" width="28" height="12" aria-hidden="true"><line x1="14" y1="0" x2="14" y2="7" stroke="#1B3FD6" stroke-width="1.5"/></svg>a chapter, numbered</li>}
              </ul>
              <a href={href("/data/journey/")}>The journey: the pace, the milestones, every reading →</a>
            </div>
          </figure>
        )
      }
      <div class="row" style="margin-top:20px">
        {/* owner decision 2A on PR #6263 (2026-11-24): the old "Start here: the moments" button is retired; it competed with
            the first screen's one primary entry into the story (the featured path). /story/moments/ stays reachable from /story/. */}
        {latestChapter && <a class="btn ghost" href="#week">Latest published chapter ↓</a>}
      </div>
    </div>
  </section>

  <section class="section hair portrait-band">
    <div class="wrap">
      <figure class="portrait" id="portrait">
        <figcaption class="between">
          <span class="label">Fig. 2 — The portrait{edition?.day_n != null && `, day ${edition.day_n}`}</span>
          <span class="verified" style="font-size:11px">{edition ? `As of ${dayInWords(edition.as_of, { short: true })}` : "From the platform"} · blank where nothing is measured in public</span>
        </figcaption>
        <div class="tiles portrait-tiles">
          {
            dims.map((d) =>
              d.href ? (
                <a class="tile" href={href(d.href)}>
                  <span class="label">{d.label} · {d.instrument}</span>
                  <span class={`v num ${d.value == null ? "hollow" : ""}`}>{d.value == null ? "—" : d.value}{d.value != null && d.unit && <small> {d.unit}</small>}{d.value != null && d.what && <small class="v-what"> {d.what}</small>}</span>
                  <span class="spark" data-spark-of={d.key} data-latest={d.latest} set:html={sparkOf(d).svg} />
                  {scaleWords(sparkOf(d).plan, d) && <span class="spark-scale mono">{scaleWords(sparkOf(d).plan, d)}</span>}
                  <span class="note">{d.note}</span>
                </a>
              ) : (
                <div class="tile">
                  <span class="label">{d.label} · {d.instrument}</span>
                  <span class={`v num ${d.value == null ? "hollow" : ""}`}>{d.value == null ? "—" : d.value}{d.value != null && d.unit && <small> {d.unit}</small>}{d.value != null && d.what && <small class="v-what"> {d.what}</small>}</span>
                  <span class="spark" data-spark-of={d.key} data-latest={d.latest} set:html={sparkOf(d).svg} />
                  {scaleWords(sparkOf(d).plan, d) && <span class="spark-scale mono">{scaleWords(sparkOf(d).plan, d)}</span>}
                  <span class="note">{d.note}</span>
                </div>
              ),
            )
          }
        </div>
        <p class="serif muted portrait-ratio">
          {WORDS[measured] ? WORDS[measured][0].toUpperCase() + WORDS[measured].slice(1) : measured} {measured === 1 ? "dimension" : "dimensions"} measured,{" "}
          {WORDS[6 - measured] || 6 - measured} not yet. That ratio is the project: the body is the easy part to instrument.
        </p>
      </figure>
      <OwnWords id="content" class="portrait-words" note="One evening's sentence, not a measurement — nothing published here measures how I feel." />
    </div>
  </section>

  {
    latestChapter && (
      <section class="section hair" id="week">
        <div class="wrap ch-feature">
          <div class="ch-lead" data-chapter={latestChapter.id} data-status={latestChapter.status}>
            <span class="label">{latestMeta?.prologue ? "Prologue" : "Chapter"}</span>
            <span class="big cobalt ch-numeral" style="display:block;line-height:.85" data-ch-no>{latestMeta?.number}</span>
            {latestMeta?.windowShort && <span class="mono muted" style="font-size:12px" data-ch-window>{latestMeta.windowShort}</span>}
            {latestMeta?.published && (
              <span class="mono muted" style="font-size:12px" data-published>
                {latestMeta.published}
              </span>
            )}
          </div>
          <article style="flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:16px">
            <div class="row">
              <span class="label">Latest published chapter</span>
              <Provenance object={latestChapter} />
            </div>
            <h2 style="font-size:44px;line-height:1.05">{latestChapter.title}</h2>
            {latestChapter.excerpt && (
              <p class="dek" style="font-size:21px">
                {latestChapter.excerpt}
              </p>
            )}
            <div class="row" style="align-items:stretch">
              <a class="btn" href={href(pathOf("chapter", latestChapter.id))}>
                Read{latestChapter.read_minutes ? ` · ${latestChapter.read_minutes} min` : ""}
              </a>
              {latestEpisode && latestEpisode.audio_url ? (
                <span class="player" style="flex:1 1 300px;min-height:48px;padding:0 10px 0 0;gap:10px">
                  <span style="font-weight:600;font-size:14px;padding-left:12px">Listen</span>
                  <audio controls preload="none" src={latestEpisode.audio_url} style="flex:1 1 200px;min-width:0;height:36px" />
                </span>
              ) : null}
            </div>
            {/* #6178: the narrator is named beside the owner's approved first-person line, never inside it (that line is byte-identical) */}
            <p class="muted ch-byline" style="font-size:13px" data-byline>{NARRATOR_BYLINE}</p>
            <p class="muted ch-byline" style="font-size:13px">Written by the platform's narrator from the week's data; published after I approved it. The figures in it are explorable in the data room.</p>
          </article>
          <aside style="flex:1 1 240px;min-width:0">
            <p class="label" style="margin-bottom:8px">In this chapter</p>
            <div class="rows">
              {inChapter && inChapter.items.length ? (
                inChapter.items.map((e) => (
                  <a href={href(pathOf(e.type, e.id, e.object))}>
                    <span style="font-size:14px;line-height:1.35">{clip(e.object.title, 60)}</span>
                    <span class="mono muted" style="font-size:11px;letter-spacing:.08em;text-transform:uppercase">{e.type}</span>
                  </a>
                ))
              ) : (
                <>
                  {chWeekDays > 0 && (
                    <a href={`${href(pathOf("chapter", latestChapter.id))}#days`}>
                      <span style="font-size:14px;line-height:1.35">The week, day by day</span>
                      <span class="mono muted" style="font-size:11px">{chWeekDays} days</span>
                    </a>
                  )}
                  <a href={href(pathOf("chapter", latestChapter.id))}>
                    <span style="font-size:14px;line-height:1.35">
                      {chWeekCalls.length
                        ? `${chWeekCalls.length} graded coach ${chWeekCalls.length === 1 ? "call" : "calls"} listed for its days`
                        : "No graded coach call listed for its days"}
                    </span>
                    {chWeekCalls.length > 0 && <span class="mono muted" style="font-size:11px">{chWeekRight} right · {chWeekCalls.length - chWeekRight} wrong</span>}
                  </a>
                </>
              )}
              {nextCh && (
                <span style="flex-direction:column;align-items:flex-start;gap:3px" data-next-chapter={nextCh.number || ""}>
                  <span style="font-size:14px">Next chapter{nextCh.number ? ` · ${nextCh.number}` : ""}</span>
                  <span class="mono muted" style="font-size:12px;max-width:100%">
                    {dayInWords(nextCh.date, { short: true, weekday: true })}
                    {next.chapter.data.drafted_not_promised ? " · drafted, not promised" : ""}
                  </span>
                </span>
              )}
            </div>
            <a href={href("/story/")} style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700">
              {published.length > 1 ? (
                <>
                  All <span data-ch-count>{count.words}</span> →
                </>
              ) : (
                "All chapters →"
              )}
            </a>
          </aside>
        </div>
      </section>
    )
  }

  {/* "What happens next" replaces "What nobody knows yet" (owner, review 11 §What happens next; review 14) */}
  <section class="section hair" id="what-happens-next">
    <div class="wrap">
      <WhatHappensNext />
    </div>
  </section>

  <section class="section hair">
    <div class="wrap">
      <div class="between" style="margin-bottom:24px">
        <h2>What's alive right now</h2>
        <span class="label wide-only">A reason to come back · rebuilt every morning</span>
      </div>
      {
        sinceAsOf != null && (
          <p class="since" data-since hidden data-asof={String(sinceAsOf)} data-events={JSON.stringify(sinceEvents)}>
            <span data-since-text />
            <a data-since-link hidden href={href("/story/")}>Read it →</a>
          </p>
        )
      }
      <div class={`grid ${openDisagreements.length > 0 ? "cols3" : "cols2"}`}>
        <div>
          <p class="label" style="margin-bottom:10px">The last seven days</p>
          {
            week ? (
              <div class="rows">
                {weekOrder.map((k) => {
                  const m = week.measures?.[k];
                  if (!m) return null;
                  return (
                    <span>
                      <span>
                        <b style="font-size:14px">{weekLabel[k] || k}</b>
                        <br />
                        <span class="muted" style="font-size:13px">
                          {m.state === "ok" ? m.data?.text : m.absent_text}
                        </span>
                      </span>
                    </span>
                  );
                })}
              </div>
            ) : (
              <div class="empty">
                <span>{blocks.week?.absent_text || "No seven-day read in the edition."}</span>
              </div>
            )
          }
          <a href={href("/data/")} style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700">The data room →</a>
        </div>
        <div>
          <p class="label" style="margin-bottom:10px">Open calls · {all.byType.prediction.filter((p) => p.status === "pending").length} pending</p>
          {
            pending.length ? (
              <div class="rows">
                {/* sprint III: rows, not links — the ledger link below lists each with its page, and the front page's link
                    budget (reach ceiling 12) carries the strangers' entry, the moments, instead */}
                {pending.map((p) => (
                  <span>
                    <span style="font-size:14px;line-height:1.35">
                      <b>{p.coach_name}</b> · {(p.claim_withheld && heldCallWords(p, 80)) || clip(p.claim, 88)}
                    </span>
                    <StatusTag status="pending" date={p.due_date} call />
                  </span>
                ))}
              </div>
            ) : (
              <div class="empty">
                <span>No open call in the snapshot.</span>
              </div>
            )
          }
          <a href={href("/system/ledger/")} style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700">All calls →</a>
        </div>
        {/* "On the table" (2026-11-14): only when two coaches openly disagree. It used to repeat the next chapter's draft
            date — already in the chapter's rail and the closing line — and otherwise said "Nothing on the table today." */}
        {openDisagreements.length > 0 && (
          <div>
            <p class="label" style="margin-bottom:10px">On the table</p>
            <div class="rows">
              {openDisagreements.slice(0, 2).map((d) => (
                <a href={href(pathOf("disagreement", d.id))}>
                  <span style="font-size:14px;line-height:1.35">
                    <b>Two coaches disagree</b> · {clip(d.topic, 70)}
                  </span>
                  <span class="status open">open</span>
                </a>
              ))}
            </div>
            <a href={href("/system/")} style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700">How the coaches work →</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section inv" id="coaches">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:40px 56px;align-items:flex-start">
      <div style="flex:1 1 520px;min-width:0;display:flex;flex-direction:column;gap:18px">
        {/* #5615: the record is every checked call since day one, not a week — the label says so */}
        <span class="label">The coaches' record{startDate ? `, since ${dayInWords(startDate, { short: true })}` : ", this cycle"}</span>
        <h2 style="color:var(--paper)">Are the AI coaches better than a guess?</h2>
        <p class="serif" style="font-size:18px;line-height:1.5;color:var(--inkmuted);max-width:56ch">
          Every coach forecast is written down with a date, then graded by code against the same readings as a guess that nothing changes. Code grades them. I can't.
        </p>
        <VersusGuess record={record ? { right: record.right, decided: record.decided } : null} inverse links={false} />
      </div>
      <div style="flex:1 1 320px;min-width:0">
        {
          lines.length > 0 && (
            <>
              <p class="label" style="margin-bottom:10px">What they said today</p>
              <div class="rows inv-rows">
                {lines.map((l) => {
                  const c = coachById(l.coach_id || "");
                  return (
                    <span style="align-items:flex-start">
                      <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
                        <span class="serif" style="font-size:16px;line-height:1.45">
                          {l.text}
                        </span>
                        <span class="mono" style="font-size:12px;color:var(--inkmuted)">
                          {l.coach || c?.name || l.coach_id}
                          {c?.domain || l.domain ? ` · ${domainWords(c?.domain || l.domain)}` : ""}
                          {l.move_label ? ` · ${l.move_label}` : ""}
                          {l.as_of && dayInWords(l.as_of) ? ` · said ${dayInWords(l.as_of, { weekday: true, short: true })}` : ""}
                        </span>
                      </span>
                    </span>
                  );
                })}
              </div>
            </>
          )
        }
        <p style="margin-top:14px;font-size:13px;color:var(--inkmuted)">The coaches are software built with Claude, not people. They read real data and speak in their own voices — correlative, never causal.</p>
        <a href={href("/system/")} style="display:inline-block;margin-top:10px;font-size:13px;font-weight:700;color:var(--paper)">How the coaches work, in plain English →</a>
      </div>
    </div>
  </section>

  <section class="section hair">
    <div class="wrap">
      <div class="between" style="margin-bottom:22px">
        <h2>Three doors. Depth behind each, never in front of it.</h2>
        <span class="label wide-only">Simple on arrival · deep on demand</span>
      </div>
      <div class="doors">
        <a class="door" href={href("/story/")}>
          <span class="between mono muted" style="font-size:12px"><span class="cobalt">01</span><span>Follow · 10 min a week</span></span>
          <span><span class="t">The story</span><p class="serif muted" style="font-size:17px;margin-top:10px">{published.length ? <><span data-ch-count>{chapterCount(all.byType.chapter, { spell: true, capital: true }).words}</span> so far</> : "A chapter a week"}{withAudio ? `, ${WORDS[withAudio] || withAudio} with audio` : ""}. Where I started, what's happened, how I'm doing — not just what I weigh.</p></span>
        </a>
        <a class="door" href={href("/data/")}>
          <span class="between mono muted" style="font-size:12px"><span class="cobalt">02</span><span>Explore · an hour, if you like</span></span>
          <span><span class="t">The data</span><p class="serif muted" style="font-size:17px;margin-top:10px">Six dimensions, {all.byType.source.filter((x) => x.status === "live").length} live sources, every method on show. Compare anything with anything, and see what the platform found when it did.</p></span>
        </a>
        <a class="door" href={href("/system/")}>
          <span class="between mono muted" style="font-size:12px"><span class="cobalt">03</span><span>Inspect · as deep as you want</span></span>
          <span><span class="t">The system</span><p class="serif muted" style="font-size:17px;margin-top:10px">The AI coaches, {ledgerForecasts ?? all.byType.prediction.filter((p) => p.status !== "observation").length} dated forecasts, every grade public — beside what a simple guess would have scored.</p></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap between">
      <div style="max-width:560px">
        <h2 style="font-size:28px">A new chapter most weeks, once I've approved it.</h2>
        <p class="serif muted" style="font-size:17px;margin-top:8px">
          {nextCh ? <span data-next-chapter={nextCh.number || ""}>{`${nextCh.number ? `Chapter ${nextCh.number}` : "The next chapter"} is drafted for ${dayInWords(nextCh.date)}; a week can be held, and the page says so when it is. `}</span> : ""}
          If the coaches are right, you'll read it there first. If they're wrong, you'll read that too.
        </p>
      </div>
      <a class="btn" href="https://averagejoematt.com/subscribe/">Follow by email</a>
    </div>
  </section>
</Base>

<script>
  import "../islands/since.js";
  import "../islands/theline.js";
</script>
