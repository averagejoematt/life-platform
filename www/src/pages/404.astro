---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url.js";
---

<Base title="Not here" top={null}>
  <section class="section">
    <div class="wrap">
      <div class="empty" style="max-width:640px">
        <b style="color:var(--ink)">Nothing at this address.</b>
        <span>The chapters start on <a href={href("/story/")}>the story page</a>; the numbers start in <a href={href("/data/")}>the data room</a>.</span>
        <a href={href("/")} style="color:var(--ink);font-weight:700">Start →</a>
      </div>
    </div>
  </section>
</Base>
