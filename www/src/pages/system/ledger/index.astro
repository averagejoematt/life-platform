---
// The ledger: every record the platform serves, one row each, newest first; the counts are
// of the records in the snapshot; the filter island hides and shows and computes nothing.
import Base from "../../../layouts/Base.astro";
import StatusTag from "../../../components/StatusTag.astro";
import Quote from "../../../components/Quote.astro";
import Glossary from "../../../components/Glossary.astro";
import ReaderCallList from "../../../components/ReaderCallList.astro";
import { DISPUTED_NOTE, isDisputed, verified } from "../../../lib/disputed.js";
import { callOutcome, dayInWords } from "../../../lib/format.js";
import { loadAll, latestEdition, loadCalibration } from "../../../lib/snapshot.js";
import { roomPublic } from "../../../lib/room.js";
import { href, pathOf } from "../../../lib/url.js";

const all = await loadAll();
const edition = await latestEdition();
const ORDER = ["pending", "confirmed", "refuted", "expired", "inconclusive", "observation"];
const rows = [...all.byType.prediction].sort((a, b) => (a.logged_date < b.logged_date ? 1 : a.logged_date > b.logged_date ? -1 : a.id < b.id ? -1 : 1));
const counts = Object.fromEntries(ORDER.map((s) => [s, rows.filter((r) => r.status === s).length]));
// Owner rulings 2026-11-03: a verdict under classification review is shown, never counted as right or wrong.
counts.confirmed = verified(rows, "confirmed").length;
counts.refuted = verified(rows, "refuted").length;
const disputed = rows.filter(isDisputed).length;
const flagged = rows.filter((r) => r.quality_flags.length).length;
const corrected = rows.filter((r) => r.corrections.length).length;
const coaches = [...all.byType.coach].filter((c) => rows.some((r) => r.coach_id === c.id)).sort((a, b) => (a.name < b.name ? -1 : 1));
const kinds = [...new Set(rows.map((r) => r.kind))].sort();
const disagreements = all.byType.disagreement;
// Owner ruling 2026-11-05: the publication method the ledger is counted under, as the export route served it.
const method = (edition?.blocks?.ledger?.data as { method?: { version?: number; effective?: string; note?: string } } | undefined)?.method;
// #5950 (2026-11-14): the page was billed as every prediction while the snapshot lists only the records the export
// serves with an id (173 of 425 that day). The whole ledger's counts are the producer's (calibration.json `record`,
// the same block the 49-of-95 headline reads), so the header reconciles with the headline one click away, and the page
// says how many records it can list and how many it cannot. Nothing is derived beyond the one subtraction it states.
let whole: any = null;
if (roomPublic()) {
  try {
    const f: any = await loadCalibration();
    whole = f?.state === "ok" && Number.isInteger(f.record?.total) ? f.record : null;
  } catch {
    whole = null;
  }
}
const unlisted = whole ? whole.total - rows.length : 0;
const KIND_WORDS: Record<string, string> = { number: "a number", direction: "a direction", yes_no: "yes or no", sealed: "sealed", interval: "an interval", observation: "an observation", unknown: "unclassified" };
---

<Base title="The prediction ledger" top="system" description="The coaches' predictions, dated and graded, with flagged grades marked and every correction kept." status={edition ? dayInWords(edition.as_of) : null}>
  <section class="section" style="padding-bottom:20px">
    <div class="wrap">
      <p class="label">System · the ledger · {whole ? `${whole.total} records · ${rows.length} listed here` : `${rows.length} records in the snapshot`}</p>
      <h1 style="font-size:44px;margin-top:8px">The prediction ledger</h1>
      {whole && (
        <div data-whole-ledger>
          <div class="facts" style="margin-top:22px">
            <div><span class="label">Right</span><span class="v num cobalt">{whole.confirmed}</span><span class="muted" style="font-size:12px">of {whole.decided} graded right or wrong</span></div>
            <div><span class="label">Wrong</span><span class="v num verm">{whole.refuted}</span><span class="muted" style="font-size:12px">as graded now, corrections applied</span></div>
            <div><span class="label">Open</span><span class="v num">{whole.pending}</span><span class="muted" style="font-size:12px">windows still open</span></div>
            <div><span class="label">Could not be checked</span><span class="v num">{whole.expired}</span><span class="muted" style="font-size:12px">too few readings{whole.inconclusive ? ` · ${whole.inconclusive} inconclusive` : ""}</span></div>
            <div><span class="label">Observations</span><span class="v num">{whole.observational}</span><span class="muted" style="font-size:12px">not graded, by design</span></div>
          </div>
          <p style="margin-top:14px;font-size:15px;line-height:1.5;max-width:78ch" data-unlisted>
            The ledger holds <b>{whole.total}</b> records; those are its counts. <b>{rows.length}</b> of them are listed below, each with its own page.
            {unlisted > 0 && ` The other ${unlisted} are served without a stable id, so they are counted above but cannot be listed or linked here yet.`}
            {" "}Of the records listed: {counts.confirmed} right, {counts.refuted} wrong, {counts.pending} open, {counts.expired} could not be checked, {counts.observation} observations.
          </p>
        </div>
      )}
      {!whole && (
      <div class="facts" style="margin-top:22px">
        <div><span class="label">Right</span><span class="v num cobalt">{counts.confirmed}</span><span class="muted" style="font-size:12px">confirmed by the grader</span></div>
        <div><span class="label">Wrong</span><span class="v num verm">{counts.refuted}</span><span class="muted" style="font-size:12px">refuted by the grader</span></div>
        <div><span class="label">Open</span><span class="v num">{counts.pending}</span><span class="muted" style="font-size:12px">windows still open</span></div>
        <div><span class="label">Could not be checked</span><span class="v num">{counts.expired}</span><span class="muted" style="font-size:12px">too few readings</span></div>
        <div><span class="label">Observations</span><span class="v num">{counts.observation}</span><span class="muted" style="font-size:12px">not graded, by design</span></div>
      </div>
      )}
      <p class="muted" style="margin-top:12px;font-size:13px">
        {disputed > 0 && `${disputed} listed ${disputed === 1 ? "record is" : "records are"} under classification review: the verdict is kept, and counted neither right nor wrong. `}
        {flagged} listed {flagged === 1 ? "grade is" : "grades are"} flagged (marked, still counted) and {corrected} carry a correction (the original is kept).
        Every count is the producer's or a count of the rows listed; the filter below only hides and shows.
      </p>
      <Glossary />
      {rows.some((p) => p.claim_withheld === "no_words") && (
        <p class="muted" style="margin-top:8px;font-size:13px" data-no-words-note>
          Some records carry no publishable commentary. Each still shows its coach, date, measure and grade.
        </p>
      )}
      {method && method.note && method.effective && (
        <p class="muted" style="margin-top:8px;font-size:13px" data-method>
          Method {method.version}, from {dayInWords(method.effective)}: {method.note}
        </p>
      )}<ReaderCallList rows={rows} recordAnchor="#calls" />
    </div>
  </section>
  <section class="wrap" style="padding-bottom:56px" data-ledger id="calls">
    <div class="controls" data-needs-js hidden style="display:flex;flex-wrap:wrap;gap:12px 18px;align-items:flex-end;margin-bottom:16px">
      <label class="sel-wrap"><span class="label">Coach</span><select class="sel" data-f-coach aria-label="Filter by coach"><option value="">every coach</option>{coaches.map((c) => <option value={c.id}>{c.name}{c.retired ? " · retired" : ""}</option>)}</select></label>
      <span class="seg" role="group" aria-label="Filter by status">
        <button type="button" data-f-status="" aria-pressed="true">All</button>
        {ORDER.filter((s) => counts[s]).map((s) => <button type="button" data-f-status={s} aria-pressed="false">{callOutcome(s)}</button>)}
      </span>
      <label class="sel-wrap"><span class="label">Kind</span><select class="sel" data-f-kind aria-label="Filter by kind"><option value="">every kind</option>{kinds.map((k) => <option value={k}>{KIND_WORDS[k] || k}</option>)}</select></label>
      <label class="sel-wrap" style="flex:1 1 220px"><span class="label">A word in the claim</span><input class="sel" type="search" data-f-text aria-label="Search the claims" placeholder="protein, recovery, sleep…" /></label>
      <span class="mono muted" style="font-size:12px;min-height:44px;display:inline-flex;align-items:center" data-count aria-live="polite">all {rows.length} records</span>
    </div>
    {
      rows.length ? (
        <div class="rows">
          {rows.map((p) => (
            <a href={href(pathOf("prediction", p.id))} data-row data-coach={p.coach_id} data-status={p.status} data-kind={p.kind} data-text={`${p.claim_withheld === "no_words" ? "" : p.claim} ${p.coach_name} ${p.metric_key || ""}`.toLowerCase()}>
              <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
                <span style="font-size:14px;line-height:1.35">
                  <b>{p.coach_name}</b>
                  <span class="muted">
                    {" "}
                    · {dayInWords(p.logged_date, { short: true })} · {KIND_WORDS[p.kind] || p.kind}
                    {p.metric_key && ` · ${p.metric_key.replace(/_/g, " ")}`}
                    {p.sealed && " · sealed"}
                  </span>
                </span>
                {p.claim_withheld !== "no_words" && (
                  <span class={p.claim_withheld ? "serif muted" : "mono"} style="font-size:13px;line-height:1.45">
                    {p.claim_withheld ? p.claim : <Quote text={p.claim} said={p.logged_date} />}
                  </span>
                )}
                {(p.quality_flags.length > 0 || p.corrections.length > 0 || isDisputed(p)) && (
                  <span>
                    {p.quality_flags.map((f) => (
                      <span class={`flag ${f}`}>{f.replace("_", " ")}</span>
                    ))}
                    {p.corrections.length > 0 && <span class="flag">corrected · original kept</span>}
                    {isDisputed(p) && <span class="flag disputed">{DISPUTED_NOTE}</span>}
                  </span>
                )}
              </span>
              <StatusTag status={p.status} date={p.settled_date} call />
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <b style="color:var(--ink)">No records.</b>
          <span>The snapshot holds no prediction.</span>
        </div>
      )
    }
    {
      disagreements.length > 0 && (
        <div style="margin-top:40px">
          <p class="label" style="margin-bottom:8px">Disagreements · two coaches on the record, the engine's number between them</p>
          <div class="rows">
            {disagreements.map((d) => (
              <a href={href(pathOf("disagreement", d.id))}>
                <span style="font-size:14px">
                  <b>{d.topic}</b>
                </span>
                <span class={`status ${d.status}`}>{d.status}</span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </section>
</Base>

<script>
  import "../../../islands/ledger.js";
</script>
