---
// /system/ledger/refuted/ — "wrong this month", the room's preset over the ledger. Built in CR3, RELEASED WITH CR1 (owner
// ruling 2026-11-09). This file lives outside src/pages/ and is injected as a route only when the room's scope is on
// (src/lib/room.js: WEB_ROOM=1 / WEB_ROOM=cr1 privately, or the committed `room_public: "cr1"`).
//
// Owner ruling 2026-11-09: the view draws ONLY from eligible, verified and publication-cleared outcomes — the calls the
// producer counts in the verified record (`verification_summary.counted_calls`, lib/calibration.js countedCalls). A call
// outside that set (unverified, excluded by classification, a repeat, under review) is never listed as a miss. When the
// producer serves no such list the page lists no miss at all (lib/docket.js verifiedMisses) — never an unverified one.
// "This month" is the snapshot's as-of month (manifest.json), never the wall clock. The month before sits folded.
import Base from "../layouts/Base.astro";
import RefutedMonth from "../components/RefutedMonth.astro";
import { countedCalls } from "../lib/calibration.js";
import { docketEntries, monthOf, previousMonth, verifiedMisses } from "../lib/docket.js";
import { dayInWords } from "../lib/format.js";
import { ROOM_MARKER, roomAll, roomEnabled, roomPublic } from "../lib/room.js";
import { loadAll, loadCalibration, loadCoachRoom, snapshotAsOf } from "../lib/snapshot.js";
import { href } from "../lib/url.js";

if (!roomEnabled()) throw new Error("src/room/refuted.astro rendered with the room off — the room route must not be injected");

const all = await loadAll();
const asOf = await snapshotAsOf();
const month = monthOf(asOf);
const nameOf = (id: string) => (all.get("coach", id) || {}).name || String(id).replace(/_coach$/, "").replace(/_/g, " ");
const preds = all.byType.prediction;
const file = await loadCalibration();
const counted = file && file.state === "ok" ? countedCalls(file.calibration) : null;
const now = verifiedMisses(preds, month, counted);
const before = verifiedMisses(preds, previousMonth(month), counted);
const n = now.wrong.length;
// early in a month the current list is short: the month before opens by default so the page is never a lone row
const openBefore = n < 5 && before.wrong.length > 0;
// the docket is CR3: read (and linked) only on a whole-room private build, never in a CR1 build
const docketOpen = roomAll() ? docketEntries(await loadCoachRoom()).length > 0 : false;
const pub = roomPublic();
const noindex = process.env.WEB_NOINDEX === "1";
const through = dayInWords(asOf);
const room = { [ROOM_MARKER]: "refuted" };
const h2 = "font-size:28px;line-height:1.15";
---

<Base title="Wrong this month" top="system" description="Every checked forecast the coaches got wrong this month, re-verified under the current rules." status={through}>
  <Fragment slot="head">{!noindex && !pub && <meta name="robots" content="noindex, nofollow" />}</Fragment>
  {
    !pub && (
      <div {...room} data-room-private="" class="mono" style="background:var(--ink);color:var(--paper);font-size:12px;padding:6px var(--pad);text-align:center">
        Coaching Room · private build · not published
      </div>
    )
  }

  <section class="section" {...room} style="padding-bottom:24px">
    <div class="wrap" style="display:flex;flex-direction:column;gap:16px;max-width:1100px">
      <p class="label"><a href={href("/system/ledger/")}>The ledger</a> · wrong this month</p>
      <h1 style="font-size:clamp(30px,5.5vw,52px);line-height:1.05" data-refuted-headline>
        {!now.verified ? "Wrong this month" : n === 0 ? `No checked forecast graded wrong in ${now.words} so far` : `${n} checked ${n === 1 ? "forecast" : "forecasts"} graded wrong in ${now.words}`}
      </h1>
      <p class="dek" style="font-size:19px;max-width:62ch">
        The misses are kept in plain view, with the call's own words where the platform publishes them.{through ? ` Through ${through}.` : ""}
      </p>
      <p class="muted" style="font-size:13px;max-width:72ch;border-left:3px solid var(--ink);padding-left:12px" data-verification>
        Only the forecasts that count in <a href={href("/system/calibration/")}>the coaches' record</a>: calls that could be checked under the current rules, whose grade was re-checked and reproduced (or reproduced as corrected), and that are cleared for publication. A call that was not re-verified, was not a checkable forecast, repeated an earlier one or is under classification review is not listed here; every call stays in the ledger.
      </p>
    </div>
  </section>

  {
    !now.verified ? (
      <section class="section" {...room} id="this-month" style="border-top:1px solid var(--ink)">
        <div class="wrap" style="display:flex;flex-direction:column;gap:12px;max-width:1100px" data-refuted-unverified>
          <div class="empty">
            <span>The platform does not yet publish which graded calls were re-verified and cleared for counting, so no miss is listed here. Every graded call, right or wrong, is in the ledger.</span>
          </div>
          <p style="font-size:14px"><a href={href("/system/ledger/")}>Every call, in the ledger →</a></p>
        </div>
      </section>
    ) : (
      <>
        <section class="section" {...room} id="this-month" style="border-top:1px solid var(--ink)">
          <div class="wrap" style="display:flex;flex-direction:column;gap:12px;max-width:1100px">
            <p class="label">{now.words}</p>
            <h2 style={h2}>{n ? "Each miss, newest first" : "Nothing graded wrong yet this month"}</h2>
            <RefutedMonth view={now} nameOf={nameOf} />
          </div>
        </section>

        <section class="section" {...room} id="last-month" style="border-top:1px solid var(--ink)">
          <div class="wrap" style="display:flex;flex-direction:column;gap:12px;max-width:1100px">
            <details open={openBefore}>
              <summary style="cursor:pointer;font-weight:700;min-height:44px;display:flex;align-items:center;font-size:18px">
                {before.words}: {before.wrong.length} checked {before.wrong.length === 1 ? "forecast" : "forecasts"} graded wrong
              </summary>
              <div style="margin-top:12px"><RefutedMonth view={before} nameOf={nameOf} /></div>
            </details>
            {docketOpen && <p style="font-size:13px;margin-top:8px"><a href={href("/system/docket/")}>The docket: where two coaches bet against each other →</a></p>}
          </div>
        </section>
      </>
    )
  }
</Base>
