{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadSite",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::matthew-life-platform/site/*"
    },
    {
      "Sid": "PublicReadBlog",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::matthew-life-platform/blog/*"
    },
    {
      "Sid": "PublicReadGenerated",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::matthew-life-platform/generated/*"
    },
    {
      "Sid": "ProtectDataFromDeployScripts",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::matthew-life-platform/raw/*",
        "arn:aws:s3:::matthew-life-platform/config/*",
        "arn:aws:s3:::matthew-life-platform/uploads/*",
        "arn:aws:s3:::matthew-life-platform/dashboard/*",
        "arn:aws:s3:::matthew-life-platform/exports/*",
        "arn:aws:s3:::matthew-life-platform/deploys/*",
        "arn:aws:s3:::matthew-life-platform/cloudtrail/*",
        "arn:aws:s3:::matthew-life-platform/imports/*",
        "arn:aws:s3:::matthew-life-platform/generated/*",
        "arn:aws:s3:::matthew-life-platform/buddy/*",
        "arn:aws:s3:::matthew-life-platform/blog/*",
        "arn:aws:s3:::matthew-life-platform/mcp-audit/*",
        "arn:aws:s3:::matthew-life-platform/datadrops-archive/*",
        "arn:aws:s3:::matthew-life-platform/claude-memory-backup/*"
      ],
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::205930651321:user/matthew-admin",
            "arn:aws:iam::205930651321:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AdministratorAccess_*"
          ]
        }
      }
    },
    {
      "Sid": "AWSCloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::matthew-life-platform",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-west-2:205930651321:trail/life-platform-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::matthew-life-platform/cloudtrail/AWSLogs/205930651321/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-west-2:205930651321:trail/life-platform-trail"
        }
      }
    }
  ]
}
