---
import { href } from "../lib/url.js";

interface Props {
  top?: string | null;
}
const { top = null } = Astro.props;
const nav = [
  ["start", "Start", "/"],
  ["story", "Story", "/story/"],
  ["data", "Data", "/data/"],
  ["system", "System", "/system/"],
];
---

<nav class="tabbar" aria-label="Primary, mobile">
  {nav.map(([key, label, path]) => <a href={href(path)} aria-current={top === key ? "page" : undefined}>{label}</a>)}
</nav>
