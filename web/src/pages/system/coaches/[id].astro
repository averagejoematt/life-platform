---
import Base from "../../../layouts/Base.astro";
import Connected from "../../../components/Connected.astro";
import Provenance from "../../../components/Provenance.astro";
import StatusTag from "../../../components/StatusTag.astro";
import { dayInWords, kOfN, clip } from "../../../lib/format.js";
import { loadAll } from "../../../lib/snapshot.js";
import { href, pathOf } from "../../../lib/url.js";

export async function getStaticPaths() {
  const all = await loadAll();
  return all.byType.coach.map((c) => ({ params: { id: c.id }, props: { coach: c } }));
}
const { coach: c } = Astro.props;
const all = await loadAll();
const mine = all.byType.prediction.filter((p) => p.coach_id === c.id).sort((a, b) => (a.logged_date < b.logged_date ? 1 : -1));
const by = (s: string) => mine.filter((p) => p.status === s).length;
---

<Base title={c.name} top="system" description={c.short_bio || `${c.name} · ${c.domain}`}>
  <section class="section">
    <div class="wrap grid cols2" style="gap:56px;align-items:start">
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="row"><span class="label">{c.tier === "lead" ? "Lead coach" : "Coach"} · {c.domain}</span><Provenance object={c} /></div>
        <h1 style="font-size:48px">{c.name}</h1>
        <p class="dek" style="font-size:19px">
          {c.retired ? `Retired${c.retired_date ? ` on ${dayInWords(c.retired_date)}` : ""}. ` : ""}
          {c.instrument_absent?.absent ? `${c.instrument_absent.reason || "No instrument."} ` : ""}
          {c.short_bio || ""}
        </p>
        <p class="muted" style="font-size:13px">An AI character: software built with Claude, not a person. It reads real data and speaks in its own voice — correlative, never causal.</p>
        <div class="facts">
          <div><span class="label">Record</span><span class="v num">{c.record ? kOfN(c.record.right, c.record.n) : "—"}</span><span class="muted" style="font-size:12px">{c.record?.through ? `through ${dayInWords(c.record.through, { short: true })}` : c.retired ? "retired" : "no checked call yet"}</span></div>
          <div><span class="label">Beside a simple guess</span><span style="font-size:14px;line-height:1.5">{c.comparison_text || "Too few calls to compare yet."}</span></div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:22px">
        <div>
          <p class="label" style="margin-bottom:8px">Predictions in the snapshot · {mine.length} · {by("confirmed")} confirmed, {by("refuted")} refuted, {by("pending")} pending</p>
          {
            mine.length ? (
              <div class="rows">
                {mine.slice(0, 12).map((p) => (
                  <a href={href(pathOf("prediction", p.id))}>
                    <span class="mono" style="font-size:13px;line-height:1.45">
                      {clip(p.claim, 110)}
                    </span>
                    <StatusTag status={p.status} date={p.settled_date} />
                  </a>
                ))}
              </div>
            ) : (
              <div class="empty">
                <span>{c.tier === "lead" ? "The lead makes no calls of its own." : "No prediction loaded for this coach."}</span>
              </div>
            )
          }
          {mine.length > 12 && <a href={href("/system/ledger/")} style="display:inline-block;margin-top:10px;font-size:13px;font-weight:700">{mine.length - 12} more in the ledger →</a>}
        </div>
        <Connected type="coach" id={c.id} cap={5} />
      </div>
    </div>
  </section>
</Base>
